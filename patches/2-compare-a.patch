+// Local-only comparison of AES-256-GCM backends, sealing and opening in place
+// so only the cipher is timed.
+
+use aes_gcm::aead::{AeadInOut, KeyInit};
+use std::hint::black_box;
+use std::time::Instant;
+
+fn time(iterations: usize, mut op: impl FnMut()) -> f64 {
+    for _ in 0..iterations / 10 + 1 {
+        op();
+    }
+    let start = Instant::now();
+    for _ in 0..iterations {
+        op();
+    }
+    start.elapsed().as_nanos() as f64 / iterations as f64
+}
+
+fn main() {
+    println!("backend, bytes, seal_ns, open_ns");
+    let key = [0x5a; 32];
+    let nonce = [7u8; 12];
+    let rustcrypto = aes_gcm::Aes256Gcm::new_from_slice(&key).unwrap();
+    let ring_key = ring::aead::LessSafeKey::new(
+        ring::aead::UnboundKey::new(&ring::aead::AES_256_GCM, &key).unwrap(),
+    );
+    let rind_key = rind::aead::Key::new(&rind::aead::AES_256_GCM, &key).unwrap();
+    for (size, iterations) in [
+        (64, 1_000_000),
+        (1024, 300_000),
+        (16 * 1024, 30_000),
+        (1024 * 1024, 500),
+    ] {
+        let mut buf = vec![0x42u8; size];
+
+        let seal = time(iterations, || {
+            black_box(
+                rustcrypto
+                    .encrypt_inout_detached(&nonce.into(), b"", buf.as_mut_slice().into())
+                    .unwrap(),
+            );
+        });
+        let mut sealed = vec![0x42u8; size];
+        let tag = rustcrypto
+            .encrypt_inout_detached(&nonce.into(), b"", sealed.as_mut_slice().into())
+            .unwrap();
+        // Open fails after the first pass decrypts in place, so re-seal is
+        // avoided by timing decrypt of a fresh copy each time.
+        let open = time(iterations, || {
+            buf.copy_from_slice(&sealed);
+            rustcrypto
+                .decrypt_inout_detached(&nonce.into(), b"", buf.as_mut_slice().into(), &tag)
+                .unwrap();
+        });
+        println!("rustcrypto, {size}, {seal:.1}, {open:.1}");
+
+        let seal = time(iterations, || {
+            black_box(
+                ring_key
+                    .seal_in_place_separate_tag(
+                        ring::aead::Nonce::assume_unique_for_key(nonce),
+                        ring::aead::Aad::empty(),
+                        &mut buf,
+                    )
+                    .unwrap(),
+            );
+        });
+        sealed.fill(0x42);
+        let tag = ring_key
+            .seal_in_place_separate_tag(
+                ring::aead::Nonce::assume_unique_for_key(nonce),
+                ring::aead::Aad::empty(),
+                &mut sealed,
+            )
+            .unwrap();
+        let open = time(iterations, || {
+            buf.copy_from_slice(&sealed);
+            ring_key
+                .open_in_place_separate_tag(
+                    ring::aead::Nonce::assume_unique_for_key(nonce),
+                    ring::aead::Aad::empty(),
+                    tag,
+                    &mut buf,
+                    0..,
+                )
+                .unwrap();
+        });
+        println!("ring, {size}, {seal:.1}, {open:.1}");
+
+        let seal = time(iterations, || {
+            black_box(
+                rind_key
+                    .seal_in_place_separate_tag(
+                        rind::aead::Nonce::assume_unique_for_key(nonce),
+                        b"",
+                        &mut buf,
+                    )
+                    .unwrap(),
+            );
+        });
+        sealed.fill(0x42);
+        let tag = rind_key
+            .seal_in_place_separate_tag(
+                rind::aead::Nonce::assume_unique_for_key(nonce),
+                b"",
+                &mut sealed,
+            )
+            .unwrap();
+        let open = time(iterations, || {
+            buf.copy_from_slice(&sealed);
+            rind_key
+                .open_in_place_separate_tag(
+                    rind::aead::Nonce::assume_unique_for_key(nonce),
+                    b"",
+                    tag,
+                    &mut buf,
+                )
+                .unwrap();
+        });
+        println!("rind, {size}, {seal:.1}, {open:.1}");
+
+        let copy = time(iterations, || {
+            buf.copy_from_slice(black_box(&sealed));
+        });
+        println!("copy-only, {size}, 0, {copy:.1}");
+    }
+}
