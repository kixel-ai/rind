+(*** VPALIGNR concatenates each 128-bit lane of src1 (high) and src2 (low),
+ *** shifts it right by imm8 bytes, and keeps the low 128 bits, so a shift
+ *** of 32 bytes or more gives zero.
+ ***)
+
+let x86_VPALIGNR = new_definition
+  `x86_VPALIGNR dest src1 src2 imm8 (s:x86state) =
+      let (x:N word) = read src1 s
+      and (y:N word) = read src2 s
+      and c = 8 * val(read imm8 s:byte) in
+      let f = \(x:int128) (y:int128).
+        (word_subword (word_ushr ((word_join:int128->int128->256 word) x y) c)
+                      (0,128):int128) in
+      if dimindex(:N) = 256 then
+        let res:(256)word = simd2 f (word_zx x) (word_zx y) in
+        (dest := (word_zx res):N word) s
+      else
+        let res:int128 = f (word_zx x) (word_zx y) in
+        (dest := (word_zx res):N word) s`;;
