 /// Whether signing runs pyca/verified-garbage's routine, which expands the
 /// private key itself: see `low::mldsa_vg`. A key pair then keeps no
 /// expansion.
 fn vg_signs() -> bool {
-    low::mldsa_vg::Sign::check().is_some()
