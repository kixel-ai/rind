 }
 
 /// The polynomials a key pair's expansion holds: `A`, then `s1`, `s2`, and
 /// `t0`.
 const fn secret_expansion_len<P: Params>() -> usize {
     P::K * P::L + P::L + 2 * P::K
 }
 


