import unittest

# The script has no .py name to cache bytecode under.
sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader("bench_report", os.path.join(HERE, "bench-report"))
spec = importlib.util.spec_from_loader("bench_report", loader)
br = importlib.util.module_from_spec(spec)
loader.exec_module(br)

ZEN3 = {"intel": 0, "adx": 1, "aes": 1, "vaes": 1, "avx2": 1, "sha": 1}
COFFEE_LAKE = {"intel": 1, "adx": 1, "aes": 1, "vaes": 0, "avx2": 1, "sha": 0}


def host(name, arch, os_name, cpuid, results):
    return {
        "schema": 1,
        "host": name,
        "commit": "0123456789abcdef0123456789abcdef01234567",
        "started": "2026-11-03T02:00:00+00:00",
        "status": "ok",
        "cpu": {"model": f"{name} CPU", "arch": arch, "logical_cpus": 8},
        "os": os_name,
        "toolchain": {"rustc": "rustc 1.98.1"},
        "rind_cpu": {"cpuid": cpuid},
        "load": {"noisy": False},
        "results": [{"operation": op, "library": lib, "ns": ns} for op, lib, ns in results],
    }


def hosts():
    return {
        "nixos": host(
            "nixos",
            "x86_64",
            "NixOS (Linux 6.18)",
            ZEN3,
            [
                ("x25519-ecdh/{lib}", "rind", 30000.0),
