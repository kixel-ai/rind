# The published functions `admin/coverage-gate check` lets no test run, each
# for its reason. An entry is a path, or a directory ending in `/`, then the
# names of the functions it allows there, or none to allow every function in
# it; a name also allows the closures inside that function. An entry that
# allows no unrun function fails the gate, so this list stays current.

# The unpublished crates, rind-fips and rind-openssl, and rind's FIPS code,
# which its unit tests compile but only rind-fips runs, and what only that
# code calls.
rind-fips/
rind-openssl/
rind/src/fips.rs
rind/src/fips/
rind/src/fips_rng.rs
rind/src/high/signature/rsa.rs modulus_bits
rind/src/mid/mldsa.rs verify_mu

# `VpaesDecKey`'s wipe: only `AesDecKey` holds one, and its drop wipes the
# whole enum first, so drop glue then finds another variant. The key keeps
# its own wipe, as every key type does.
rind/src/low/aarch64/vpaes_armv8.rs drop
rind/src/low/x86_64/vpaes_x86_64.rs drop

# Error mappings for a failure no test can cause: signing failing with a key
# that loaded, a message past a cipher's length limit or `isize::MAX`, and
# rind-object-store's arm for an algorithm a later object_store adds.
rind-object-store/src/lib.rs sign unsupported
rind-python/src/lib.rs bytes_with
rind-rustls/src/sign.rs sign
rind-str0m/src/srtp.rs apply seal

# Bindings that pyrind's and rind for Dart's 0.4 reshapes rewrite, which
# /quest/m2/confidence/uncovered-functions.md then tests.
rind-dart/src/lib.rs to_spki rind_dart_public_key_new
rind-python/src/rsa.rs from_pkcs1 to_pkcs8 from_components to_spki
rind-python/src/signature.rs from_seed_and_public_key to_spki
