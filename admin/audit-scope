#!/usr/bin/env python3

# Usage: admin/audit-scope table | files [PHASE]
#
# `table` prints the file and line inventory AUDIT-SCOPE.md quotes, at the
# commit it names, and `files` prints every file in scope, one per line with
# its phase, area, lines, and whether it is generated, tab-separated, for an
# auditor's own spreadsheet. PHASE is `1` or `2`.
#
# The page's table is a dated snapshot, as AUDIT.md's `unsafe` count is, not a
# checked one: lines move with every change to the code, and a gate on them
# would fail each pull request that touches it.
#
# A file is generated when its header says an importer or `admin/parse-asm`
# wrote it ("generated source", "Generated by admin/"), or when it is an
# imported `.s` file `global_asm!` includes: nobody edits it, and
# `admin/regenerate` fails if it differs from what the importer writes.

import pathlib, re, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent

# Post-quantum code, wherever it sits: ML-KEM, ML-DSA, and SLH-DSA.
PQ = re.compile(r"(^|/)(mlkem|mldsa|slhdsa|slh_dsa|ml_kem|ml_dsa)")

# What a file under `rind/src/mid` or `rind/src/high` is for, by its stem.
# Anything not listed here is Phase 1: a primitive or encoding a TLS stack
# reaches. The Phase 2 ones are reached by no TLS handshake.
MID_PHASE2 = re.compile(r"^(argon2|blake2b|pbkdf2_vg|ristretto255(_tests)?)\.rs$|^(mlkem|mldsa|slhdsa)|(^|/)hash_to_curve")
HIGH_PHASE2 = re.compile(
    r"^(argon2|pbkdf2|hpke|kem|oprf|frost|spake2plus|vrf|blind_rsa|hmac_drbg)(\.rs|/)"
)

# Other crates, by directory: Phase 1 is the TLS provider boundary, Phase 2
# the bindings and the FIPS module, and the rest are adapters over rind's own
# API.
BINDINGS = ("rind-python", "rind-dart", "rind-openssl", "rind-fips")
OUT = (
    "rind-bench", "rind-cpuid", "rind-timing", "rind-acvp", "fuzz", "admin", "sh", "site", "benchmarks",
    "quest", ".github", "thirdparty", "patch", "t3.json",
)

# Lean files that state what a reviewer must read rather than check: a file
# with an `axiom`, a hand model of Rust Aeneas cannot translate, a model of an
# instruction, and a transliteration of a standard or an upstream spec. Chosen
# by name, from proofs/README.md's Layout; the ledger there is authoritative.
LEAN_MODEL = re.compile(
    # Hand models and instruction models, in any directory.
    r"(Model|External|Dispatch|Simd|Neon|NeonVectors|Avx512Vectors|Lanes512)\.lean$"
    r"|^proofs/Rind/(SymCrypt|Portable)/(?!.*(Entry|Compare|CtEqual|ShaBlocks))"
    # The specs `proofs/Rind` states its theorems against, at its top level.
    r"|^proofs/Rind/(Core|Spec|Bytes|HashSpec|GhashSpec|Gf128|Vale|ValeBytes|Lanes|Keccak|Sha2|AesInverse|Aes|AesModes"
    r"|AesModesBytes|AesKw|Rsa|Ed25519|MlKem|S2nChaCha20Poly1305|S2nMlKem|S2nSha256|S2nSha512)\.lean$"
    r"|/(SignatureBuffer|GcmKey|HkdfExpand|AesGcmModel)\.lean$"
)
LEAN_AXIOMS = "Lean TCB: files that state axioms"
LEAN_MODELS = "Lean TCB: hand models, ISA models, and transliterated specs"
LEAN_PROOFS = "Lean: proofs and Aeneas glue (machine-checked)"
AXIOM = re.compile(r"^\s*(private |protected )?axiom ", re.M)

GEN = re.compile(r"generated source|[Gg]enerated by `?admin/")


def tracked():
    out = subprocess.run(["git", "-C", str(ROOT), "ls-files", "-z"], capture_output=True, check=True).stdout
    return sorted(f for f in out.decode().split("\0") if f and (ROOT / f).is_file())


def classify(f):
    """Returns (phase, area) for a file, or None when it is not code under review."""
    p = f.split("/")
    if p[0] == "proofs":
        if f.endswith(".lean"):
            text = (ROOT / f).read_text()
            if p[1] == "verified-garbage" and p[2] in ("VerifiedGarbage", "RindIsa"):
                return "1", LEAN_MODELS
            if AXIOM.search(text):
                return "1", LEAN_AXIOMS
            if LEAN_MODEL.search(f):
                return "1", LEAN_MODELS
            return "1", LEAN_PROOFS
        if f.endswith(".ml"):
            return "1", "HOL Light: rind's proofs of its own assembly"
        return None
    if p[0] == "rind" and p[1] == "tests" or f.startswith("rind/src/test") or p[:3] == ["rind", "src", "testdata"]:
        return None
    if f.endswith(".md") or f.endswith(".toml") and p[0] != "rind":
        return None
    if p[0] == "rind" and p[1] == "src":
        rest = p[2:]
        if not f.endswith((".rs", ".s")):
            return None
        if rest[0] == "low":
            if len(rest) > 2 and rest[1] in ("x86_64", "aarch64", "arm", "generic", "portable"):
                layer = f"`low/{rest[1]}`"
                tail = "/".join(rest[1:])
            elif len(rest) > 2 and rest[1] == "abi":
                layer, tail = "`low` shared files", "abi"
            else:
                layer, tail = "`low` shared files", "/".join(rest[1:])
            if PQ.search(tail) or re.search(r"(^|/)argon2\.rs$", tail):
                return "2", f"{layer}: post-quantum and Argon2 kernels"
            return "1", f"{layer}"
        if rest[0] == "mid":
            name = "/".join(rest[1:])
            if MID_PHASE2.search(name):
                kind = "post-quantum" if PQ.search(name) else "KDF, hash-to-curve, and ristretto255"
                return "2", f"`mid`: {kind}"
            return "1", "`mid`: primitives and constructions"
        if rest[0] == "high":
            name = "/".join(rest[1:])
            if HIGH_PHASE2.search(name):
                return "2", "`high`: protocols (HPKE, OPRF, FROST, SPAKE2+, VRF, blind RSA, KDFs)"
            return "1", "`high`: keys, signatures, encodings, and hashing"
        if rest[0] in ("fips", "fips.rs", "fips_rng.rs"):
            return "2", "`rind` FIPS build glue"
        return "1", "`rind` crate root: public API and errors"
    if p[0] == "rind-rustls":
        return ("1", "`rind-rustls`: the TLS provider") if p[1] == "src" and f.endswith(".rs") else None
    if p[0] in BINDINGS:
        if f.endswith((".rs", ".dart", ".py", ".c", ".h")) and p[1] in ("src", "lib", "python", "include", "module"):
            return "2", f"`{p[0]}`: " + {
                "rind-python": "Python bindings",
                "rind-dart": "Dart FFI",
                "rind-openssl": "OpenSSL 3 provider",
                "rind-fips": "FIPS module (unpublished)",
            }[p[0]]
        return None
    if p[0].startswith("rind-") and p[0] not in OUT:
        return ("2", "other `rind-<consumer>` adapters") if len(p) > 2 and p[1] == "src" and f.endswith(".rs") else None
    return None


def generated(f):
    if f.endswith(".s"):
        return True
    if not f.endswith(".rs"):
        return False
    head = (ROOT / f).read_text(errors="replace").split("\n", 8)[:8]
    return any(GEN.search(line) for line in head)


def scan():
    rows = []
    for f in tracked():
        c = classify(f)
        if not c:
            continue
        lines = (ROOT / f).read_bytes().count(b"\n")
        rows.append((c[0], c[1], f, lines, generated(f)))
    return rows


def lean_trust():
    """The Lean `axiom` and `sorry` counts, which the ledger in proofs/README.md must list."""
    axioms = files_with = sorries = 0
    for f in tracked():
        if f.startswith("proofs/") and f.endswith(".lean"):
            text = (ROOT / f).read_text()
            n = len(AXIOM.findall(text))
            axioms += n
            files_with += bool(n)
            sorries += len(re.findall(r"^[^-\n]*\bsorry\b", text, re.M))
    return f"Lean `axiom` declarations: {axioms} in {files_with} files. `sorry`: {sorries}."


def render():
    rows = scan()
    out = []
    names = {
        "1": "Phase 1: the audit's first engagement",
        "2": "Phase 2: follow-on",
    }
    for phase in ("1", "2"):
        areas = {}
        for ph, area, f, n, g in rows:
            if ph != phase:
                continue
            a = areas.setdefault(area, [0, 0, 0])
            a[0] += 1
            a[1] += 0 if g else n
            a[2] += n if g else 0
        out.append(f"**{names[phase]}**\n")
        out += ["| Area | Files | Hand-written lines | Generated lines |", "|---|---:|---:|---:|"]
        t = [0, 0, 0]
        for area in sorted(areas):
            a = areas[area]
            out.append(f"| {area} | {a[0]:,} | {a[1]:,} | {a[2]:,} |")
            t = [x + y for x, y in zip(t, a)]
        out.append(f"| **Total** | **{t[0]:,}** | **{t[1]:,}** | **{t[2]:,}** |")
        out.append("")
        if phase == "1":
            out += [lean_trust(), ""]
    return "\n".join(out).rstrip("\n")


def files(phase):
    for ph, area, f, n, g in scan():
        if phase is None or ph == phase:
            print(f"{ph}\t{area}\t{n}\t{'generated' if g else 'hand'}\t{f}")


def main():
    match sys.argv[1:]:
        case ["table"]:
            print(render())
        case ["files"]:
            files(None)
        case ["files", phase]:
            files(phase)
        case _:
            sys.exit("usage: admin/audit-scope table | files [PHASE]")


main()
