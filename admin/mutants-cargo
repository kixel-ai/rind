#!/usr/bin/env bash
# cargo-mutants invokes this as $CARGO. rind-rcgen's `zeroize` cannot live in
# a `features` setting in `.cargo/mutants.toml`: cargo-mutants passes that list
# to every package, and a package that does not depend on rind-rcgen fails to
# resolve it.
#
# Add it when this invocation builds only rind-rcgen. A workspace or
# mixed-package command cannot take it, because cargo requires every
# selected package to define a feature it is given. That command runs as
# given, and rind-rcgen is then built again with the feature, so its
# zeroize tests are not compiled out and a zeroize mutant is not reported missed.
# `--exclude` is not copied onto that second build: cargo accepts it only
# with `--workspace`. Excluding rind-rcgen skips the follow-up, so the
# wrapper does not build the package the caller left out. cargo reads an
# `--exclude` value as a glob, so `--exclude 'rind-*'` excludes it too.
# `--features` is not copied either, except the features rind-rcgen declares:
# the workspace command can name a feature that only another member has, and
# cargo rejects it on the package alone. Under nextest, a follow-up that
# selects no tests because of an inherited filter exits 4, which is not a
# failure of the run cargo-mutants asked for.
#
# `build` is left unchanged. cargo-mutants 27.1.0's build phase is
# `cargo test --no-run` or `nextest run --no-run`, and its check phase is
# `cargo check --tests`. Those are the commands this wrapper rewrites.
set -euo pipefail

real=${RIND_REAL_CARGO:-cargo}
if [[ $# -eq 0 ]]; then
    exec "$real"
fi

case $1 in
    test | check | nextest) ;;
    *) exec "$real" "$@" ;;
esac

features=(--features=zeroize)

# Whether an `--exclude` value, a glob as cargo reads it, names rind-rcgen. The
# version after an `@` is not part of the pattern.
excludes_rcgen() {
    local pattern=${1%%@*}
    # shellcheck disable=SC2053 # The unquoted right side is the glob.
    [[ rind-rcgen == $pattern ]]
}

# The features rind-rcgen declares, one per line.
rcgen_features() {
    awk '/^\[features\]/ { in_features = 1; next }
         /^\[/ { in_features = 0 }
         in_features && /^[A-Za-z0-9_-]+[ \t]*=/ { print $1 }' \
        "$(dirname "${BASH_SOURCE[0]}")/../rind-rcgen/Cargo.toml"
}

# Prints the entries of a `--features` value, split on commas and spaces, that
# rind-rcgen declares, each as `--features=NAME`.
rcgen_feature_args() {
    local declared entry
    declared=$(rcgen_features)
    for entry in ${1//,/ }; do
        entry=${entry#rind-rcgen/}
        if grep -qxF -- "$entry" <<<"$declared"; then
            printf -- '--features=%s\n' "$entry"
        fi
    done
}

# Words after the first `--` belong to the test binary, not to cargo.
cargo_args=()
passthru=()
seen_dd=0
for arg in "$@"; do
    if [[ $seen_dd -eq 1 ]]; then
        passthru+=("$arg")
    elif [[ $arg == -- ]]; then
        seen_dd=1
    else
        cargo_args+=("$arg")
    fi
done

packages=()
workspace=0
prev=
for arg in "${cargo_args[@]}"; do
    case $arg in
        --workspace) workspace=1 ;;
        --package=*) packages+=("${arg#--package=}") ;;
        # `-prind-rcgen`, the attached form of `-p`.
        -p?*) packages+=("${arg#-p}") ;;
    esac
    if [[ $prev == --package || $prev == -p ]]; then
        packages+=("$arg")
    fi
    prev=$arg
done

rcgen_spec=
others=0
for pkg in "${packages[@]}"; do
    if [[ ${pkg%%@*} == rind-rcgen ]]; then
        if [[ -z $rcgen_spec ]]; then
            rcgen_spec=$pkg
        fi
    else
        others=1
    fi
done

# No package filter builds every workspace member, rind-rcgen included.
if [[ ${#packages[@]} -eq 0 ]]; then
    workspace=1
fi

# Only rind-rcgen: one command, with the feature on it.
if [[ -n $rcgen_spec && $others -eq 0 && $workspace -eq 0 ]]; then
    args=()
    inserted=0
    for arg in "$@"; do
        if [[ $inserted -eq 0 && $arg == -- ]]; then
            args+=("${features[@]}" --)
            inserted=1
        else
            args+=("$arg")
        fi
    done
    if [[ $inserted -eq 0 ]]; then
        args+=("${features[@]}")
    fi
    exec "$real" "${args[@]}"
fi

# rind-rcgen is not in this build.
if [[ $workspace -eq 0 && -z $rcgen_spec ]]; then
    exec "$real" "$@"
fi

# Workspace or mixed packages. The first command is the one cargo-mutants
# asked for. The second builds rind-rcgen alone, with the feature, and
# forwards the same test-binary arguments. `--exclude` and its spec are
# dropped: the follow-up has no `--workspace`, and cargo rejects `--exclude`
# on its own. An exclusion of rind-rcgen means there is no second command.
"$real" "$@"

spec=${rcgen_spec:-rind-rcgen}
extra=()
skip_next=0
skip_kind=
excluded_rcgen=0
for arg in "${cargo_args[@]}"; do
    if [[ $skip_next -eq 1 ]]; then
        case $skip_kind in
            exclude)
                if excludes_rcgen "$arg"; then
                    excluded_rcgen=1
                fi
                ;;
            features)
                while IFS= read -r feature; do
                    extra+=("$feature")
                done < <(rcgen_feature_args "$arg")
                ;;
        esac
        skip_next=0
        skip_kind=
        continue
    fi
    case $arg in
        --workspace | --package=* | -p?*) ;;
        --exclude=*)
            if excludes_rcgen "${arg#--exclude=}"; then
                excluded_rcgen=1
            fi
            ;;
        --features=* | -F?*)
            value=${arg#--features=}
            if [[ $arg == -F?* ]]; then
                value=${arg#-F}
                value=${value#=}
            fi
            while IFS= read -r feature; do
                extra+=("$feature")
            done < <(rcgen_feature_args "$value")
            ;;
        --package | -p)
            skip_next=1
            skip_kind=package
            ;;
        --exclude)
            skip_next=1
            skip_kind=exclude
            ;;
        --features | -F)
            skip_next=1
            skip_kind=features
            ;;
        *) extra+=("$arg") ;;
    esac
done
if [[ $excluded_rcgen -eq 1 ]]; then
    exit 0
fi
extra+=(--package="$spec" "${features[@]}")
if [[ $seen_dd -eq 1 ]]; then
    extra+=(-- "${passthru[@]+"${passthru[@]}"}")
fi
status=0
"$real" "${extra[@]}" || status=$?
# nextest exits 4 when no test ran. The first command ran the caller's filter
# on every package, so a follow-up the filter empties is not a failed run.
if [[ $1 == nextest && $status -eq 4 ]]; then
    exit 0
fi
exit "$status"
