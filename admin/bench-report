#!/usr/bin/env python3
"""Times rind and the libraries it is compared with on the report's hosts.

Usage:
  admin/bench-report collect [--commit REV] [--host NAME]... [--out DIR]
  admin/bench-report summary DIR

`collect` copies one commit to each host in turn, builds rind-bench there with
the pinned toolchain, and times every operation in OPERATIONS for every
library that offers it. It runs here for the host this is, and over ssh for
the others. A host that is busy, unreachable, or fails is recorded and
skipped, never measured. DIR (default `.tmp/bench-report/<commit>`) gets one
`<host>.json` per host, with its CPU, OS, toolchain, and library versions.

`summary` prints a Markdown table of a collection: rind's time per operation
and host, against the fastest other library's.

`run` is the host side of `collect`, run from the copied checkout. Results
written to DIR are measurements, not history: rerun `collect` to refresh them.
"""

import argparse
import datetime
import glob
import json
import os
import platform
import re
import resource
import shlex
import shutil
import socket
import subprocess
import sys
import time

# The report's hosts, in the order they run. `jobs` caps the build: nixos2 is
# a shared 15 GB machine that more jobs run out of memory.
HOSTS = {
    "nixos": {"jobs": 16},
    "desktop": {"jobs": 12},
    "nixos2": {"jobs": 2},
    "kixtop": {"jobs": 4},
}

# A host is busy when other work keeps more than this share of its logical
# CPUs, or one CPU, busy: enough to change clock speeds and shared caches
# under a single-threaded benchmark.
BUSY_SHARE = 0.1

# Where each host keeps its copy, its build, and its result, under its home
# directory; this host uses the checkout's `.tmp/` instead.
REMOTE_DIR = ".cache/rind-bench-report"

# Criterion's timing, shortened from 3 s of warm-up and 5 s of measurement so
# that a host's run takes about half an hour.
CRITERION_ARGS = ["--noplot", "--warm-up-time", "1", "--measurement-time", "3"]

# The report's operations, most common first, as criterion IDs with `{lib}`
# in the library's place. Each is timed for every library rind-bench has a
# row for.
OPERATIONS = [
    # TLS 1.3, with both peers in one process.
    "rustls-full-handshake-group/x25519mlkem768/{lib}",
    "rustls-full-handshake-group/x25519/{lib}",
    "rustls-full-handshake-group/secp256r1/{lib}",
    "rustls-full-handshake-key/ed25519/{lib}",
    "rustls-full-handshake-key/rsa-2048/{lib}",
    "rustls-resumed-handshake/x25519/{lib}",
    "rustls-bulk/aes128-gcm/{lib}",
    "rustls-bulk/aes256-gcm/{lib}",
    "rustls-bulk/chacha20poly1305/{lib}",
    # AEADs.
    *(
        f"{aead}/{{lib}}/{size}"
        for aead in [
            "aes128-gcm",
            "aes128-gcm-open",
            "aes256-gcm",
            "aes256-gcm-open",
            "chacha20poly1305",
            "xchacha20poly1305",
        ]
        for size in ["32B", "1350B", "16KB"]
    ),
    # Key agreement.
    "x25519-ecdh/{lib}",
    "p256-ecdh/{lib}",
    # Signatures.
    "ed25519-sign/{lib}",
    "ed25519-verify/{lib}",
    "p256-ecdsa-sign/{lib}",
    "p256-ecdsa-verify/{lib}",
    # Hashes and KDFs.
    *(f"{hash}/{{lib}}/{size}" for hash in ["sha256", "sha512"] for size in ["64B", "1350B", "16KB"]),
    "hmac-sha256/{lib}/64B",
    "hmac-sha256/{lib}/1350B",
    "hkdf-sha256/extract-expand/{lib}",
    "hkdf-sha256/expand/{lib}",
    # RSA.
    "rsa2048-pkcs1-sha256-sign/{lib}",
    "rsa2048-pkcs1-sha256-verify/{lib}",
    "rsa2048-pss-sha256-sign/{lib}",
    "rsa2048-pss-sha256-verify/{lib}",
    # ML-KEM.
    "mlkem768-keygen/{lib}",
    "mlkem768-encaps/{lib}",
    "mlkem768-decaps/{lib}",
    # P-384 and P-521.
    "p384-ecdh/{lib}",
    "p384-ecdsa-sign/{lib}",
    "p384-ecdsa-verify/{lib}",
    "p521-ecdh/{lib}",
    "p521-ecdsa-sign/{lib}",
    "p521-ecdsa-verify/{lib}",
]

# Each library's name in the report, from the row names rind-bench keeps for
# the history of its older benchmarks.
LIBRARIES = {
    "rind": "rind",
    "aws-lc-rs": "aws-lc-rs",
    "ring": "ring",
    "rustcrypto": "rustcrypto",
    "p256-rustcrypto": "rustcrypto",
    "p384-rustcrypto": "rustcrypto",
    "dalek": "rustcrypto",
    "graviola": "graviola",
    "libcrux": "libcrux",
    "libcrux-ml-kem": "libcrux",
    "openssl": "openssl",
}

# The crates whose versions a result records, by library.
CRATES = {
    "rind": ["rind", "rind-rustls"],
    "aws-lc-rs": ["aws-lc-rs", "aws-lc-sys"],
    "ring": ["ring"],
    "rustcrypto": [
        "aes-gcm",
        "chacha20poly1305",
        "sha2",
        "hmac",
        "hkdf",
        "p256",
        "p384",
        "p521",
        "rsa",
        "ml-kem",
        "ed25519-dalek",
        "x25519-dalek",
    ],
    "graviola": ["graviola", "rustls-graviola"],
    "libcrux": [
        "libcrux-aes",
        "libcrux-chacha20poly1305",
        "libcrux-ecdh",
        "libcrux-ecdsa",
        "libcrux-ed25519",
        "libcrux-hkdf",
        "libcrux-hmac",
        "libcrux-ml-kem",
        "libcrux-rsa",
        "libcrux-sha2",
    ],
    "openssl": ["openssl", "openssl-sys", "rustls-openssl"],
    "tls": ["rustls"],
}

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def fail(message):
    sys.exit(f"bench-report: {message}")


def operation_regex():
    """A criterion filter matching exactly the report's operations."""
    ops = "|".join(re.escape(op).replace(re.escape("{lib}"), "[^/]+") for op in OPERATIONS)
    return f"^({ops})$"


def operation_of(full_id):
    """The operation and library of a criterion ID, or None if it is not one."""
    for op in OPERATIONS:
        pattern = "^" + re.escape(op).replace(re.escape("{lib}"), "([^/]+)") + "$"
        m = re.match(pattern, full_id)
        if m:
            return op, m.group(1)
    return None


def pinned_toolchain():
    with open(os.path.join(ROOT, "flake.nix")) as f:
        m = re.search(r'rust-bin\.stable\."([0-9.]+)"', f.read())
    if not m:
        fail("flake.nix names no pinned stable toolchain")
    return m.group(1)


# --- host side --------------------------------------------------------------


def cpu_count():
    return os.cpu_count() or 1


def busy_limit():
    return max(1.0, BUSY_SHARE * cpu_count())


def cpu_times():
    """The system's (busy, total) CPU time in clock ticks, on Linux."""
    with open("/proc/stat") as f:
        fields = [int(x) for x in f.readline().split()[1:]]
    idle = fields[3] + fields[4]
    return sum(fields) - idle, sum(fields)


def busy_cpus(seconds=5):
    """How many logical CPUs other work keeps busy, averaged over `seconds`."""
    if sys.platform == "linux":
        busy0, total0 = cpu_times()
        time.sleep(seconds)
        busy1, total1 = cpu_times()
        return (busy1 - busy0) / max(1, total1 - total0) * cpu_count()
    # macOS: top's second sample covers the interval.
    out = subprocess.run(
        ["top", "-l", "2", "-n", "0", "-s", str(seconds)], capture_output=True, text=True, check=True
    ).stdout
    idle = re.findall(r"CPU usage:.*?([0-9.]+)% idle", out)[-1]
    return (100 - float(idle)) / 100 * cpu_count()


def check_idle(when):
    busy = busy_cpus()
    if busy > busy_limit():
        raise Busy(f"{busy:.1f} of {cpu_count()} CPUs busy {when} (limit {busy_limit():.1f})")
    return round(busy, 2)


class Busy(Exception):
    pass


def output(cmd, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, check=True, env=env).stdout.strip()


def cpu_model():
    if sys.platform == "darwin":
        return output(["sysctl", "-n", "machdep.cpu.brand_string"])
    with open("/proc/cpuinfo") as f:
        for line in f:
            if line.startswith(("model name", "Model")):
                return line.split(":", 1)[1].strip()
    return platform.processor()


def os_name():
    if sys.platform == "darwin":
        return f"macOS {platform.mac_ver()[0]} ({platform.release()})"
    pretty = platform.system()
    if os.path.exists("/etc/os-release"):
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    pretty = line.split("=", 1)[1].strip().strip('"')
    return f"{pretty} (Linux {platform.release()})"


def locked_versions():
    """Each package's versions in Cargo.lock."""
    versions = {}
    with open(os.path.join(ROOT, "Cargo.lock")) as f:
        for name, version in re.findall(r'\[\[package\]\]\nname = "([^"]+)"\nversion = "([^"]+)"', f.read()):
            versions.setdefault(name, []).append(version)
    return versions


def toolchain(env):
    """The cargo command for the pinned toolchain, refusing any other."""
    pinned = pinned_toolchain()
    if sys.platform == "darwin":
        # No Nix here: rustup provides the same release.
        cargo = ["rustup", "run", pinned, "cargo"]
        rustc = ["rustup", "run", pinned, "rustc"]
        prefix = output(["brew", "--prefix", "openssl@3"])
        env["OPENSSL_DIR"] = prefix
        openssl = os.path.join(prefix, "bin", "openssl")
    else:
        if os.environ.get("IN_RIND_DEV_SHELL") != "1":
            fail("run inside the dev shell: nix develop --command admin/bench-report run ...")
        cargo, rustc, openssl = ["cargo"], ["rustc"], "openssl"
    version = output(rustc + ["-vV"], env)
    release = re.search(r"^release: (.+)$", version, re.M).group(1)
    if release != pinned:
        fail(f"rustc {release} is not the pinned {pinned}")
    return cargo, {"rustc": version.splitlines()[0], "cargo": output(cargo + ["-V"], env)}, openssl


def run(args):
    started = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    result = {
        "schema": 1,
        "host": args.host,
        "commit": args.commit,
        "started": started,
        "cpu": {"model": cpu_model(), "arch": platform.machine(), "logical_cpus": cpu_count()},
        "os": os_name(),
    }

    def finish(status, **fields):
        result.update(status=status, **fields)
        with open(args.out, "w") as f:
            json.dump(result, f, indent=1)
            f.write("\n")

    try:
        idle_before_build = check_idle("before the build")
    except Busy as e:
        finish("busy", reason=str(e))
        fail(f"{args.host}: {e}")

    env = dict(os.environ, CARGO_BUILD_JOBS=str(args.jobs), CARGO_TERM_COLOR="never")
    env["CARGO_TARGET_DIR"] = os.path.abspath(args.target_dir)
    cargo, versions, openssl = toolchain(env)
    result["toolchain"] = versions
    locked = locked_versions()
    result["libraries"] = {
        lib: {crate: ", ".join(locked.get(crate, ["?"])) for crate in crates} for lib, crates in CRATES.items()
    }
    result["libraries"]["openssl"]["library"] = output([openssl, "version"], env)

    bench = cargo + ["bench", "-p", "rind-bench", "--features", "__bench_openssl"]
    subprocess.run(bench + ["--no-run"], env=env, check=True)
    # The CPU features rind reads, which pick its paths on this host.
    result["rind_cpu"] = json.loads(output(cargo + ["run", "-q", "--release", "-p", "rind-cpuid"], env))

    try:
        idle_before_run = check_idle("before the benchmarks")
    except Busy as e:
        finish("busy", reason=str(e))
        fail(f"{args.host}: {e}")

    criterion_dir = os.path.join(env["CARGO_TARGET_DIR"], "criterion")
    shutil.rmtree(criterion_dir, ignore_errors=True)
    criterion_args = CRITERION_ARGS + [operation_regex()]
    wall0 = time.monotonic()
    ticks0 = cpu_times()[0] if sys.platform == "linux" else None
    ours0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    subprocess.run(bench + ["--"] + criterion_args, env=env, check=True)
    ours1 = resource.getrusage(resource.RUSAGE_CHILDREN)
    wall = time.monotonic() - wall0

    load = {
        "limit_cpus": round(busy_limit(), 2),
        "busy_cpus_before_build": idle_before_build,
        "busy_cpus_before_run": idle_before_run,
    }
    if ticks0 is not None:
        # Other work during the run: the system's busy time less the
        # benchmarks' own.
        system = (cpu_times()[0] - ticks0) / os.sysconf("SC_CLK_TCK")
        ours = (ours1.ru_utime + ours1.ru_stime) - (ours0.ru_utime + ours0.ru_stime)
        load["other_busy_cpus_during_run"] = round(max(0.0, system - ours) / wall, 2)
        load["noisy"] = load["other_busy_cpus_during_run"] > busy_limit()

    results = []
    for path in sorted(glob.glob(os.path.join(criterion_dir, "**", "new", "benchmark.json"), recursive=True)):
        with open(path) as f:
            meta = json.load(f)
        found = operation_of(meta["full_id"])
        if found is None:
            continue
        op, lib = found
        with open(os.path.join(os.path.dirname(path), "estimates.json")) as f:
            estimates = json.load(f)
        estimate = estimates.get("slope") or estimates["mean"]
        results.append(
            {
                "operation": op,
                "library": LIBRARIES.get(lib, lib),
                "id": meta["full_id"],
                "ns": estimate["point_estimate"],
                "ns_low": estimate["confidence_interval"]["lower_bound"],
                "ns_high": estimate["confidence_interval"]["upper_bound"],
                "throughput": meta.get("throughput"),
            }
        )
    order = {op: i for i, op in enumerate(OPERATIONS)}
    results.sort(key=lambda r: (order[r["operation"]], r["library"]))
    finish(
        "ok",
        finished=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
        criterion_args=criterion_args,
        load=load,
        results=results,
    )


# --- collection -------------------------------------------------------------


def is_local(host):
    return host == socket.gethostname().split(".")[0]


def on_host(host, script, **kwargs):
    """Runs a shell script on `host`, here or over ssh."""
    if is_local(host):
        return subprocess.run(["sh", "-c", script], **kwargs)
    return subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, script], **kwargs)


def collect_host(host, commit, out_dir):
    out = os.path.join(out_dir, f"{host}.json")
    work = os.path.join(ROOT, ".tmp", "bench-report", "host") if is_local(host) else REMOTE_DIR
    q = shlex.quote

    def record(status, reason):
        with open(out, "w") as f:
            json.dump({"schema": 1, "host": host, "commit": commit, "status": status, "reason": reason}, f, indent=1)
            f.write("\n")
        print(f"bench-report: {host}: {status}: {reason}", file=sys.stderr)

    probe = on_host(host, "uname -s", capture_output=True, text=True)
    if probe.returncode != 0:
        return record("unreachable", probe.stderr.strip())
    darwin = probe.stdout.strip() == "Darwin"

    # A fresh copy of the commit; the build directory stays between runs.
    archive = subprocess.run(["git", "-C", ROOT, "archive", "--format=tar", commit], capture_output=True, check=True)
    copy = on_host(
        host,
        f"rm -rf {q(work)}/src && mkdir -p {q(work)}/src && tar -x -C {q(work)}/src",
        input=archive.stdout,
    )
    if copy.returncode != 0:
        return record("failed", "could not copy the commit")

    cmd = (
        f"python3 admin/bench-report run --host {q(host)} --commit {q(commit)} "
        f"--jobs {HOSTS[host]['jobs']} --target-dir ../target --out ../result.json"
    )
    if not darwin:
        cmd = f'nix develop "path:$PWD" --command {cmd}'
    on_host(host, f"rm -f {q(work)}/result.json && cd {q(work)}/src && {cmd}")
    fetched = on_host(host, f"cat {q(work)}/result.json", capture_output=True)
    if fetched.returncode != 0:
        return record("failed", "the run wrote no result; see its output above")
    with open(out, "wb") as f:
        f.write(fetched.stdout)
    status = json.loads(fetched.stdout)["status"]
    print(f"bench-report: {host}: {status}", file=sys.stderr)


def collect(args):
    commit = output(["git", "-C", ROOT, "rev-parse", f"{args.commit}^{{commit}}"])
    hosts = args.host or list(HOSTS)
    for host in hosts:
        if host not in HOSTS:
            fail(f"unknown host {host}; known: {', '.join(HOSTS)}")
    out_dir = args.out or os.path.join(ROOT, ".tmp", "bench-report", commit[:12])
    os.makedirs(out_dir, exist_ok=True)
    # One host at a time, so no run shares a machine or a network with another.
    for host in hosts:
        collect_host(host, commit, out_dir)
    print(out_dir)


def human(ns):
    if ns < 1e3:
        return f"{ns:.0f} ns"
    if ns < 1e6:
        return f"{ns / 1e3:.2f} µs"
    return f"{ns / 1e6:.2f} ms"


def summary(args):
    hosts = []
    for host in HOSTS:
        path = os.path.join(args.dir, f"{host}.json")
        if os.path.exists(path):
            with open(path) as f:
                hosts.append(json.load(f))
    measured = [h for h in hosts if h["status"] == "ok"]
    for h in hosts:
        if h["status"] == "ok":
            noisy = " (noisy)" if h["load"].get("noisy") else ""
            print(f"- `{h['host']}`: {h['cpu']['model']}, {h['os']}, {h['toolchain']['rustc']}{noisy}")
        else:
            print(f"- `{h['host']}`: not measured, {h['status']}: {h['reason']}")
    print()
    print("| operation | " + " | ".join(h["host"] for h in measured) + " |")
    print("|---|" + "---|" * len(measured))
    for op in OPERATIONS:
        cells = []
        for h in measured:
            times = {r["library"]: r["ns"] for r in h["results"] if r["operation"] == op}
            others = {lib: ns for lib, ns in times.items() if lib != "rind"}
            if "rind" not in times or not others:
                cells.append("-")
                continue
            best = min(others, key=others.get)
            ratio = times["rind"] / others[best]
            cells.append(f"{human(times['rind'])}, {ratio:.2f}× {best}")
        print(f"| {op.replace('/{lib}', '')} | " + " | ".join(cells) + " |")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("collect", help="run the benchmarks on each host")
    p.add_argument("--commit", default="HEAD", help="the commit to measure (default HEAD)")
    p.add_argument("--host", action="append", help="a host to measure (default: all, in order)")
    p.add_argument("--out", help="the results directory (default .tmp/bench-report/<commit>)")
    p.set_defaults(func=collect)

    p = sub.add_parser("summary", help="print a collection's rind-versus-fastest table")
    p.add_argument("dir")
    p.set_defaults(func=summary)

    p = sub.add_parser("run", help="the host side of collect")
    p.add_argument("--host", required=True)
    p.add_argument("--commit", required=True)
    p.add_argument("--jobs", type=int, required=True)
    p.add_argument("--target-dir", required=True)
    p.add_argument("--out", required=True)
    p.set_defaults(func=run)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
