# Memcheck findings in dependencies that rind cannot fix in its own code.

# libcrux decides whether a tag verified, then branches on that decision. The
# outcome is public, but libcrux does not declassify it for memcheck.
{
   libcrux-aes-gcm-decrypt-outcome
   Memcheck:Cond
   src:aes_gcm.rs:99
   fun:*libcrux_aes*
}

# On armv7 without NEON, memcheck reports aws-lc's integer SHA-512 at the
# `beq` at sha512_block_data_order_nohw+460, which reads only the Z flag of
# `tst r14,#1` (the K512 pointer) at +456. That `tst` takes its carry from the
# `adds` of secret words before it, and memcheck counts that carry against the
# condition when a superblock boundary falls between the two, as the caller's
# code layout decides. Run 41557470707 (moq-dev/rind#254) found no report at
# the default layout. With one instruction per superblock it flagged only the
# readers of tests on round constants and pointers, even the `bne` after
# `teq r1,r2`, which compares two public pointers.
{
   aws-lc-sha512-armv4-nohw-flags
   Memcheck:Cond
   fun:rind_*_sha512_block_data_order_nohw
}

# rind-rcgen's PEM goes through pem-rfc7468 and base64ct, whose per-character
# arithmetic is branch-free. What they branch on is public: whether the
# decoded input was well-formed (`err == 0` in `decode`, the round-trip
# compare in `validate_last_block`) and that the encoded output is ASCII
# (pem-rfc7468's high-bit fold, and `str::from_utf8` on base64ct's output,
# which only ever holds alphabet characters, including the block
# `validate_last_block` re-encodes). Frames are v0-mangled, or short
# names where a release build inlined them.
{
   base64ct-decode-validity
   Memcheck:Cond
   fun:*8base64ct8encoding*8Encoding6decode*
}
{
   base64ct-decode-validity-inlined
   Memcheck:Cond
   fun:decode<base64ct::*
}
{
   base64ct-last-block-validity
   Memcheck:Cond
   fun:*8base64ct8encoding19validate_last_block*
}
{
   base64ct-last-block-validity-inlined
   Memcheck:Cond
   fun:validate_last_block<base64ct::*
}
{
   pem-rfc7468-encoded-is-ascii
   Memcheck:Cond
   fun:*11pem_rfc74687encoder6encode
}
{
   pem-rfc7468-encoded-is-utf8
   Memcheck:Cond
   fun:*utf8*
   ...
   fun:*pem_rfc7468*encoder*
}
{
   base64ct-encoded-is-utf8
   Memcheck:Cond
   fun:*utf8*
   fun:*8base64ct8encoding*8Encoding6encode*
}
{
   pem-rfc7468-encoded-is-utf8-index
   Memcheck:Value8
   fun:*utf8*
   ...
   fun:*pem_rfc7468*encoder*
}
