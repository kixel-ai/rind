# Memcheck findings in dependencies that rind cannot fix in its own code.

# libcrux decides whether a tag verified, then branches on that decision. The
# outcome is public, but libcrux does not declassify it for memcheck.
{
   libcrux-aes-gcm-decrypt-outcome
   Memcheck:Cond
   src:aes_gcm.rs:99
   fun:*libcrux_aes*
}

# libcrux-hacl-rs bignum constant-time finding, reported privately; drop once
# fixed (quest/m1/moq/libcrux-ct-fixes.md).
{
   libcrux-hacl-rs-bignum-modexp
   Memcheck:Value4
   fun:*bn_mod_exp_consttime_precomp_u64*
}
{
   libcrux-hacl-rs-bignum-reduction
   Memcheck:Cond
   fun:*bn_almost_mont_reduction_u64*
}
