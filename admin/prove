#!/usr/bin/env bash
# Translates rind's Rust under proof to Lean with Charon and Aeneas, fails if
# the translation differs from the committed `proofs/Rind/<Arch>/{Types,Funs}.lean`,
# then checks every proof in `proofs/`.
#
# Usage: admin/prove [--write]
#
# `--write` replaces the committed translation instead of comparing, for a
# change to the Rust under proof. Run it in the flake's `prove` dev shell:
# `nix develop .#prove --command admin/prove`.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
write=0
[[ "${1:-}" == --write ]] && write=1
out=.tmp/prove
mkdir -p "$out"

# The X25519 path from rind's public agreement API down to s2n-bignum's
# routines. `low` is opaque: its routines are inline assembly, whose proven
# contracts `proofs/Rind/<Arch>/S2nBignum.lean` states. The x86_64 BMI2/ADX
# dispatch and the constant-time markers are Rust, so they are translated.
# The other curves' functions are opaque; their types are kept, since the
# agreement enums hold them.
extract() {
    local arch=$1 dir=$2
    shift 2
    (cd rind && charon cargo --preset=aeneas \
        --start-from crate::high::agreement \
        --opaque crate::low \
        --opaque 'crate::mid::p256::_::_' \
        --opaque 'crate::mid::p384::_::_' \
        --opaque 'crate::mid::p521::_::_' \
        --opaque '{impl core::fmt::Debug for _}::fmt' \
        --include 'crate::mid::p521::_::BYTES' \
        --include crate::low::ct \
        "$@" \
        --dest-file "$PWD/../$out/$arch.llbc" \
        -- -p rind --lib --target "$arch-unknown-linux-gnu")
    rm -rf "$out/lean"
    aeneas -backend lean -split-files -abort-on-error \
        -no-progress-bar -dest "$out/lean" -subdir "Rind/$dir" \
        -namespace "rind.$arch" "$out/$arch.llbc"
    for file in Types Funs; do
        if ((write)); then
            cp "$out/lean/Rind/$dir/$file.lean" "proofs/Rind/$dir/$file.lean"
        elif ! diff -u "proofs/Rind/$dir/$file.lean" "$out/lean/Rind/$dir/$file.lean" >&2; then
            echo "admin/prove: proofs/Rind/$dir/$file.lean differs from the translation; run admin/prove --write" >&2
            exit 1
        fi
    done
}

extract x86_64 X86_64 \
    --include crate::low::x86_64::adx_mux::curve25519_x25519 \
    --include crate::low::x86_64::adx_mux::curve25519_x25519base
extract aarch64 Aarch64

cd proofs
lake exe cache get
lake build
