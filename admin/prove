#!/usr/bin/env bash
# Translates rind's Rust under proof to Lean with Charon and Aeneas, into
# `proofs/Rind/<Arch>/{Types,Funs}.lean`, then checks every proof in `proofs/`.
#
# Each target's translation is its own namespace, but they share global names,
# so no Lean module imports both. The aarch64 hand models and its X25519 and
# SHA-512 proofs are the x86_64 ones with the target renamed, which this
# writes too.
#
# Usage: admin/prove
#
# Run it in the flake's `prove` dev shell: `nix develop .#prove --command
# admin/prove`.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
out=.tmp/prove
mkdir -p "$out"

# Each hand model quotes the Rust it models. Fail if that Rust has changed, so
# the model is reviewed with every change to it: print the first item each line
# starts, from that line to the closing one at its indentation, then a blank
# line.
items() {
    local file=$1
    shift
    for start in "$@"; do
        awk -v s="$start" '
            !p && index($0, s) == 1 { p = 1; ind = substr($0, 1, match($0, /[^ ]/) - 1) }
            p { print }
            p && (index($0, ind "}") == 1 || (ind == "" && /^[^ }].*;$/)) { print ""; exit }' "$file"
    done
}
check_quote() {
    local path=$1 model=${1#*/}
    shift
    sed -n '/^```rust$/,/^```$/{//!p}' "proofs/Rind/$path.lean" >"$out/$model.rs"
    diff -u --label "$model.lean" --label rind/src "$out/$model.rs" <("$@")
}
agreement_items() {
    items rind/src/high/agreement.rs 'pub struct Algorithm ' 'pub static X25519:' \
        'impl PrivateKey {' 'struct Keyed<' 'struct Ops<' 'impl<K: Agree> Keyed<K> {'
    items rind/src/low/generic/zeroise.rs 'pub(crate) struct ZeroableRef<' 'impl<T> ZeroableRef<T> {'
}
p256_items() {
    items rind/src/high/agreement.rs 'pub static ECDH_P256:'
    items rind/src/mid/p256.rs '    pub(crate) fn new_random(' '    pub(crate) fn generate(rng: &mut dyn'
    items rind/src/mid/rng.rs 'impl RandomSource for SystemRandom {'
}
check_quote X86_64/Dispatch agreement_items
check_quote Aarch64/P256Dispatch p256_items
check_quote X86_64/DigestAlgorithm items rind/src/high/digest.rs 'pub struct Algorithm ' 'impl Algorithm {' \
    'pub static SHA1:' 'pub static SHA256:' 'pub static SHA384:' 'pub static SHA512:' \
    'pub static SHA512_256:'
check_quote X86_64/DigestDispatch items rind/src/high/digest.rs 'pub fn digest(' 'impl Context {' \
    'impl State {' 'struct Hashing<' 'struct Ops<' 'impl<C: Variant> Hashing<C> {'
# The models' `Ops` hold nothing, since the quoted constructor builds the only
# one, and their `Algorithm` is which static it is. That holds while each
# quote has every mention of `Ops`, and every `Algorithm` the source builds.
complete() {
    local pattern=$1 file=$2 model=$3
    if [ "$(grep -o "$pattern" "$file" | wc -l)" != "$(grep -o "$pattern" "$out/$model.rs" | wc -l)" ]; then
        echo "$file has $pattern outside $model.lean's quote" >&2
        exit 1
    fi
}
complete '\bOps\b' rind/src/high/agreement.rs Dispatch
complete '\bOps\b' rind/src/high/digest.rs DigestDispatch
complete '= Algorithm {' rind/src/high/digest.rs DigestAlgorithm

# The X25519 path, and aarch64's P-256 path, from `high::agreement`'s `Agree`
# impls down to s2n-bignum's routines, and the SHA-512 family's from
# `high::digest` and `high::hash` down to aws-lc's. `low` is opaque: its
# routines are inline assembly, whose proven contracts
# `proofs/Rind/<Arch>/{S2nBignum,AwsLc}.lean` state. The x86_64 BMI2/ADX
# dispatch, the SHA-512 dispatch, the padding and buffering in
# `low::generic::blockwise`, and the constant-time markers are Rust, so they
# are translated. The other curves' functions are opaque; their types are
# kept, since the agreement enums hold them.
#
# Aeneas cannot translate function pointers, through which `PrivateKey`
# reaches each curve's `Agree` impl and `digest::Context` each hash's, so the
# translation starts below that dispatch, and `proofs/Rind/X86_64/Dispatch.lean`
# and `DigestDispatch.lean` model it by hand. `digest::Algorithm` holds them,
# so it is opaque too, and `DigestAlgorithm.lean` models it. SHA-1's and
# SHA-256's code is opaque: no theorem is about it. P-256's key generation
# draws through a `dyn RandomSource`, so it is opaque too, and
# `proofs/Rind/Aarch64/P256Dispatch.lean` models it above the translated
# `PrivateKey::from_bytes`. The generator table is opaque: the theorems assume
# what s2n-bignum's proof does of it.
extract() {
    local arch=$1 dir=$2
    shift 2
    (cd rind && charon cargo --preset=aeneas \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::x25519::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p256::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p384::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p521::PrivateKey}' \
        --start-from '{impl core::convert::AsRef for crate::high::agreement::PublicKey}' \
        --start-from '{impl core::convert::AsRef for crate::high::agreement::SharedSecret}' \
        --start-from crate::high::agreement::PrivateKey \
        --start-from crate::high::agreement::AlgorithmId \
        --start-from '{impl crate::high::digest::Variant for _}' \
        --start-from '{impl crate::high::hash::Hash for _}' \
        --start-from '{impl core::convert::AsRef for crate::high::digest::Digest}' \
        --start-from crate::high::digest::Context \
        --start-from crate::mid::sha2::Sha512_256Context::truncate \
        --opaque crate::high::agreement::Ops \
        --opaque crate::high::digest::Ops \
        --opaque crate::high::digest::Algorithm \
        --opaque 'crate::high::digest::_::output_len' \
        --opaque crate::high::digest::SHA1 \
        --opaque crate::high::digest::SHA256 \
        --opaque crate::high::digest::SHA384 \
        --opaque crate::high::digest::SHA512 \
        --opaque crate::high::digest::SHA512_256 \
        --opaque '{impl crate::high::hash::Hash for crate::high::hash::LegacySha1}' \
        --opaque '{impl crate::high::hash::Hash for crate::high::hash::Sha256}' \
        --opaque '{impl crate::high::hash::HashContext for crate::high::hash::Sha1Context}' \
        --opaque '{impl crate::high::hash::HashContext for crate::high::hash::Sha256Context}' \
        --opaque '{impl crate::high::hash::HashState for crate::high::hash::Sha1State}' \
        --opaque '{impl crate::high::hash::HashState for crate::high::hash::Sha256State}' \
        --opaque crate::low \
        --opaque 'crate::mid::p384::_::_' \
        --opaque 'crate::mid::p521::_::_' \
        --include 'crate::mid::p521::_::BYTES' \
        --include crate::low::ct \
        --include crate::low::generic::blockwise \
        --include "crate::low::$arch::sha512::sha512_compress_blocks" \
        "$@" \
        --dest-file "$PWD/../$out/$arch.llbc" \
        -- -p rind --lib --target "$arch-unknown-linux-gnu")
    rm -rf "$out/lean"
    aeneas -backend lean -split-files -abort-on-error \
        -no-progress-bar -dest "$out/lean" -subdir "Rind/$dir" \
        -namespace "rind.$arch" "$out/$arch.llbc"
    cp "$out/lean/Rind/$dir/Types.lean" "$out/lean/Rind/$dir/Funs.lean" "proofs/Rind/$dir/"
}

extract x86_64 X86_64 \
    --opaque 'crate::mid::p256::_::_' \
    --include crate::low::x86_64::adx_mux::curve25519_x25519 \
    --include crate::low::x86_64::adx_mux::curve25519_x25519base
extract aarch64 Aarch64 \
    --start-from crate::mid::p256::PrivateKey::from_bytes \
    --opaque 'crate::mid::p256::_::generate' \
    --opaque 'crate::mid::p256::_::new_random' \
    --opaque crate::mid::p256::precomp

for file in Dispatch X25519 DigestAlgorithm DigestDispatch Sha512; do
    sed 's/X86_64/Aarch64/g; s/x86_64/aarch64/g' "proofs/Rind/X86_64/$file.lean" >"proofs/Rind/Aarch64/$file.lean"
done

cd proofs
lake exe cache get
lake build
