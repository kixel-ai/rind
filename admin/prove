# The X25519 path, and aarch64's P-256 path, from `high::agreement`'s `Agree`
# impls down to s2n-bignum's routines, and the SHA-512 family's from
# `high::digest` and `high::hash` down to aws-lc's. `low` is opaque: its
# routines are inline assembly, whose proven contracts
# `proofs/Rind/<Arch>/{S2nBignum,AwsLc}.lean` state. The x86_64 BMI2/ADX
# dispatch, the SHA-512 dispatch, the padding and buffering in
# `low::generic::blockwise`, and the constant-time markers are Rust, so they
# are translated. The other curves' functions are opaque; their types are
# kept, since the agreement enums hold them. Then ChaCha20 header protection
# from its `Mask` impl down to HACL*'s rounds, which are Rust and translated
# too; AES's key and block cipher are opaque. Then Ed25519 from
# `high::signature`'s key pair and `high::ed25519` down to s2n-bignum's
# routines and the SHA-512 context.
#
# Aeneas cannot translate function pointers, through which `PrivateKey`
# reaches each curve's `Agree` impl, `HeaderProtectionKey` each cipher's
# `Mask` impl, `digest::Context` each hash's, and `signature::PublicKey` each
# algorithm's parser and verifier, so the translation starts below that
# dispatch, and `proofs/Rind/X86_64/Dispatch.lean`, `DigestDispatch.lean`, and
# `SignatureDispatch.lean` model it by hand. `agreement::Algorithm` holds the
# agreement API's, and its `PublicKey` holds an `Algorithm`, so it is opaque,
# and `Dispatch.lean` models it. `digest::Algorithm` holds the
# digest API's, so it is opaque too, and `DigestAlgorithm.lean` models it;
# `signature::PublicKey` holds the signature API's, so no translated function
# reaches it, and `SignatureDispatch.lean` defines it. SHA-1's and SHA-256's
# padding is translated down to their block functions, which are opaque.
# MD5 and SHA-3's sponge, which no proof covers, are opaque.
# P-256's key generation draws through a `dyn RandomSource`, so it is opaque
# too, and `proofs/Rind/Aarch64/P256Dispatch.lean` models it above the
# translated `PrivateKey::from_bytes`, as `EcdsaDispatch.lean` does for ECDSA,
# with the signature API's ECDSA key pairs and statics, which hold function
# pointers too. The generator table is translated, so
# `proofs/Rind/Aarch64/P256Table.lean` can prove it holds what s2n-bignum's
# proof assumes. HMAC's keyed states are translated over any hash, and its
# `Key` and `Context`, which hold function pointers, are not.
extract() {
    local arch=$1 dir=$2
    shift 2
    (cd rind && charon cargo --preset=aeneas \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::x25519::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p256::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p384::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p521::PrivateKey}' \
        --start-from '{impl core::convert::AsRef for crate::high::agreement::PublicKey}' \
        --start-from '{impl core::convert::AsRef for crate::high::agreement::SharedSecret}' \
        --start-from crate::high::agreement::PrivateKey \
        --start-from crate::high::agreement::AlgorithmId \
        --start-from '{impl crate::high::digest::Variant for _}' \
        --start-from '{impl crate::high::hash::Hash for _}' \
        --start-from '{impl core::convert::AsRef for crate::high::digest::Digest}' \
        --start-from crate::high::digest::Context \
        --start-from crate::mid::sha2::Sha512_256Context::truncate \
        --start-from '{impl crate::aead::quic::Mask for crate::mid::chacha20::ChaCha20}' \
        --start-from '{impl crate::aead::quic::Mask for crate::mid::aes::Aes}' \
        --start-from crate::aead::quic::HeaderProtectionKey \
        --start-from crate::aead::quic::AlgorithmId \
        --start-from crate::mid::chacha20::ChaCha20::new \
        --start-from 'crate::high::hmac::HmacKey::_' \
        --start-from 'crate::high::hmac::Hmac::_' \
        --start-from '{impl core::clone::Clone for crate::high::hmac::Hmac<_>}' \
        --start-from crate::high::ed25519::Ed25519VerifyingKey::from_bytes \
        --start-from crate::high::ed25519::Ed25519VerifyingKey::verify \
        --start-from crate::high::ed25519::Ed25519VerifyingKey::as_bytes \
        --start-from crate::high::ed25519::Ed25519SigningKey::generate \
        --start-from crate::high::ed25519::Ed25519SigningKey::from_bytes \
        --start-from crate::high::ed25519::Ed25519SigningKey::sign \
        --start-from crate::high::ed25519::Ed25519SigningKey::public_key \
        --start-from crate::high::signature::Ed25519KeyPair::generate \
        --start-from crate::high::signature::Ed25519KeyPair::from_seed_and_public_key \
        --start-from crate::high::signature::Ed25519KeyPair::sign \
        --start-from '{impl core::convert::AsRef for crate::high::signature::Signature}' \
        --start-from crate::high::signature::Buffer::copy_from \
        --opaque crate::high::agreement::Algorithm \
        --opaque crate::high::agreement::Ops \
        --opaque crate::high::agreement::x25519_from_pkcs8 \
        --opaque crate::high::agreement::x25519_to_pkcs8 \
        --opaque crate::high::sec1::decode \
        --opaque crate::high::sec1::decode_pkcs8 \
        --opaque crate::high::sec1::encode \
        --opaque crate::high::sec1::encode_pkcs8 \
        --opaque 'crate::high::agreement::_::encode_pkcs8' \
        --opaque 'crate::high::agreement::_::encode_scalar' \
        --opaque '{impl crate::high::agreement::Agree for crate::mid::p384::PrivateKey}::load' \
        --opaque '{impl crate::high::agreement::Agree for crate::mid::p521::PrivateKey}::load' \
        --opaque crate::aead::quic::Masker \
        --opaque crate::mid::aes \
        --opaque crate::high::digest::Ops \
        --opaque crate::high::digest::Algorithm \
        --opaque crate::high::digest::Digest \
        --opaque 'crate::high::digest::_::zeroed' \
        --opaque 'crate::high::digest::_::as_mut' \
        --opaque 'crate::high::digest::_::ct_equal' \
        --opaque 'crate::high::digest::_::as_ref' \
        --opaque 'crate::high::digest::_::output_len' \
        --opaque crate::high::digest::MD5 \
        --opaque crate::high::digest::SHA1 \
        --opaque crate::high::digest::SHA256 \
        --opaque crate::high::digest::SHA384 \
        --opaque crate::high::digest::SHA512 \
        --opaque crate::high::digest::SHA512_256 \
        --opaque crate::high::digest::SHA3_256 \
        --opaque crate::high::digest::SHA3_384 \
        --opaque crate::high::digest::SHA3_512 \
        --opaque crate::mid::md5 \
        --opaque crate::mid::sha3 \
        --opaque crate::low \
        --opaque 'crate::mid::p384::_::_' \
        --opaque 'crate::mid::p521::_::_' \
        --include 'crate::mid::p521::_::BYTES' \
        --include crate::low::ct \
        --include crate::low::generic::blockwise \
        --include crate::low::generic::chacha20 \
        --include "crate::low::$arch::sha512::sha512_compress_blocks" \
        "$@" \
        --dest-file "$PWD/../$out/$arch.llbc" \
        -- -p rind --lib --target "$arch-unknown-linux-gnu")
    rm -rf "$out/lean"
    aeneas -backend lean -split-files -abort-on-error \
        -no-progress-bar -dest "$out/lean" -subdir "Rind/$dir" \
        -namespace "rind.$arch" "$out/$arch.llbc"
    cp "$out/lean/Rind/$dir/Types.lean" "$out/lean/Rind/$dir/Funs.lean" "proofs/Rind/$dir/"
}

# HKDF and PBKDF2, in a second translation above the HMAC API, whose dispatch
# `proofs/Rind/X86_64/HmacDispatch.lean` models on the first's `HmacKey` and
# `Hmac`: one translation's external declarations precede all of its code, so
# none of its code can call a model built on it. This one has its own
# namespace, under the first's, whose names it reaches for what it leaves
# opaque, and `proofs/Rind/X86_64/Kdf/{Types,Funs}External.lean` define the
# rest. HKDF-Expand's loop over `info`, a slice of borrowed slices, is opaque,
# and `proofs/Rind/X86_64/HkdfExpand.lean` models it.
extract_kdf() {
    local arch=$1 dir=$2
    (cd rind && charon cargo --preset=aeneas \
        --start-from crate::high::hkdf::Salt::new \
        --start-from crate::high::hkdf::Salt::extract \
        --start-from crate::high::hkdf::Prk::expand \
        --start-from crate::high::hkdf::Okm::fill \
        --start-from crate::high::pbkdf2::Secret::new \
        --start-from crate::high::pbkdf2::Secret::derive \
        --start-from crate::high::pbkdf2::Secret::verify \
        --opaque 'crate::high::hkdf::_::expand_into' \
        --opaque crate::high::hmac \
        --opaque crate::high::digest \
        --opaque crate::low \
        --opaque crate::mid \
        --opaque crate::aead \
        --dest-file "$PWD/../$out/$arch-kdf.llbc" \
        -- -p rind --lib --target "$arch-unknown-linux-gnu")
    rm -rf "$out/lean"
    aeneas -backend lean -split-files -abort-on-error \
        -no-progress-bar -dest "$out/lean" -subdir "Rind/$dir/Kdf" \
        -namespace "rind.$arch.kdf" "$out/$arch-kdf.llbc"
    mkdir -p "proofs/Rind/$dir/Kdf"
    # Aeneas names both of `ZeroablePrimitive`'s `Copy` clauses, which
    # `NonZeroU32::get` brings in, `markerCopyInst`, which Lean refuses as a
    # duplicate field. Nothing reads them, so rename the second.
    sed 's/"markerCopyInst", "markerCopyInst"/"markerCopyInst", "markerCopyInst1"/;
        s/^  markerCopyInst : core.marker.Copy Self_NonZeroInner$/  markerCopyInst1 : core.marker.Copy Self_NonZeroInner/' \
        "$out/lean/Rind/$dir/Kdf/Types.lean" >"proofs/Rind/$dir/Kdf/Types.lean"
    sed 's/^  markerCopyInst := core.num.niche_types.NonZeroU32Inner.Insts.CoreMarkerCopy$/  markerCopyInst1 := core.num.niche_types.NonZeroU32Inner.Insts.CoreMarkerCopy/' \
        "$out/lean/Rind/$dir/Kdf/Funs.lean" >"proofs/Rind/$dir/Kdf/Funs.lean"
}

