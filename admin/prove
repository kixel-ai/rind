#!/usr/bin/env bash
# Translates rind's Rust under proof to Lean with Charon and Aeneas, into
# `proofs/Rind/<Arch>/{Types,Funs}.lean`, then checks every proof in `proofs/`.
#
# Each target's translation is its own namespace, but they share global names,
# so no Lean module imports both. The aarch64 dispatch model and X25519 proof
# are the x86_64 ones with the target renamed, which this writes too.
#
# Usage: admin/prove
#
# Run it in the flake's `prove` dev shell: `nix develop .#prove --command
# admin/prove`.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
out=.tmp/prove
mkdir -p "$out"

# `Dispatch.lean` quotes the Rust it models. Fail if that Rust has changed, so
# the model is reviewed with every change to it: print each quoted item, from
# the line that starts it to its closing line at column 0, then a blank line.
items() {
    local file=$1
    shift
    for start in "$@"; do
        awk -v s="$start" 'index($0, s) == 1 { p = 1 } p { print } p && (/^}/ || /^[^ }].*;$/) { p = 0; print "" }' "$file"
    done
}
sed -n '/^```rust$/,/^```$/{//!p}' proofs/Rind/X86_64/Dispatch.lean >"$out/dispatch.rs"
diff -u --label Dispatch.lean --label rind/src "$out/dispatch.rs" \
    <(items rind/src/high/agreement.rs 'pub struct Algorithm ' 'pub static X25519:' \
        'impl PrivateKey {' 'struct Keyed<' 'struct Ops<' 'impl<K: Agree> Keyed<K> {'
    items rind/src/low/generic/zeroise.rs 'pub(crate) struct ZeroableRef<' 'impl<T> ZeroableRef<T> {')
# The model's `Ops<K>` holds nothing, since the quoted `Keyed::generate` builds
# the only one. That holds while the quote has every mention of `Ops`.
if [ "$(grep -ow Ops rind/src/high/agreement.rs | wc -l)" != "$(grep -ow Ops "$out/dispatch.rs" | wc -l)" ]; then
    echo "rind/src/high/agreement.rs names Ops outside Dispatch.lean's quote" >&2
    exit 1
fi

# The X25519 path from `high::agreement`'s `Agree` impls down to s2n-bignum's
# routines, and the SHA-512 family's from `high::digest`'s contexts and
# `high::hash`'s impls down to aws-lc's routines. `low` is opaque: its routines are inline assembly, whose proven
# contracts `proofs/Rind/<Arch>/S2nBignum.lean` states. The x86_64 BMI2/ADX
# dispatch and the constant-time markers are Rust, so they are translated. The
# other curves' functions are opaque; their types are kept, since the
# agreement enums hold them.
#
# Aeneas cannot translate function pointers, through which `PrivateKey`
# reaches each curve's `Agree` impl and `digest::Context` each hash's, so the
# translation starts below that dispatch, and `proofs/Rind/X86_64/Dispatch.lean`
# and `DigestDispatch.lean` model it by hand. `digest::Algorithm` holds them,
# so it is opaque too, and `DigestAlgorithm.lean` models it. SHA-1's and
# SHA-256's code is opaque: no theorem is about it.
extract() {
    local arch=$1 dir=$2
    shift 2
    (cd rind && charon cargo --preset=aeneas \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::x25519::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p256::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p384::PrivateKey}' \
        --start-from '{impl crate::high::agreement::Agree for crate::mid::p521::PrivateKey}' \
        --start-from '{impl core::convert::AsRef for crate::high::agreement::PublicKey}' \
        --start-from '{impl core::convert::AsRef for crate::high::agreement::SharedSecret}' \
        --start-from crate::high::agreement::PrivateKey \
        --start-from crate::high::agreement::AlgorithmId \
        --start-from '{impl crate::high::digest::Variant for _}' \
        --start-from '{impl crate::high::hash::Hash for _}' \
        --start-from '{impl core::convert::AsRef for crate::high::digest::Digest}' \
        --start-from crate::high::digest::Context \
        --start-from crate::mid::sha2::Sha512_256Context::truncate \
        --opaque crate::high::agreement::Ops \
        --opaque crate::high::digest::Ops \
        --opaque crate::high::digest::Algorithm \
        --opaque 'crate::high::digest::_::output_len' \
        --opaque crate::high::digest::SHA1 \
        --opaque crate::high::digest::SHA256 \
        --opaque crate::high::digest::SHA384 \
        --opaque crate::high::digest::SHA512 \
        --opaque crate::high::digest::SHA512_256 \
        --opaque '{impl crate::high::hash::Hash for crate::high::hash::LegacySha1}' \
        --opaque '{impl crate::high::hash::Hash for crate::high::hash::Sha256}' \
        --opaque '{impl crate::high::hash::HashContext for crate::high::hash::Sha1Context}' \
        --opaque '{impl crate::high::hash::HashContext for crate::high::hash::Sha256Context}' \
        --opaque '{impl crate::high::hash::HashState for crate::high::hash::Sha1State}' \
        --opaque '{impl crate::high::hash::HashState for crate::high::hash::Sha256State}' \
        --opaque crate::low \
        --opaque 'crate::mid::p256::_::_' \
        --opaque 'crate::mid::p384::_::_' \
        --opaque 'crate::mid::p521::_::_' \
        --include 'crate::mid::p521::_::BYTES' \
        --include crate::low::ct \
        --include crate::low::generic::blockwise \
        --include "crate::low::$arch::sha512::sha512_compress_blocks" \
        "$@" \
        --dest-file "$PWD/../$out/$arch.llbc" \
        -- -p rind --lib --target "$arch-unknown-linux-gnu")
    rm -rf "$out/lean"
    aeneas -backend lean -split-files -abort-on-error \
        -no-progress-bar -dest "$out/lean" -subdir "Rind/$dir" \
        -namespace "rind.$arch" "$out/$arch.llbc"
    cp "$out/lean/Rind/$dir/Types.lean" "$out/lean/Rind/$dir/Funs.lean" "proofs/Rind/$dir/"
}

extract x86_64 X86_64 \
    --include crate::low::x86_64::adx_mux::curve25519_x25519 \
    --include crate::low::x86_64::adx_mux::curve25519_x25519base
extract aarch64 Aarch64

for file in Dispatch X25519; do
    sed 's/X86_64/Aarch64/g; s/x86_64/aarch64/g' "proofs/Rind/X86_64/$file.lean" >"proofs/Rind/Aarch64/$file.lean"
done

cd proofs
lake exe cache get
lake build
