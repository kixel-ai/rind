# The models' `Ops` hold nothing, since the quoted constructor builds the only
# one; `Masker<C>` holds only the key, since the quoted `Masker::new` builds
# each with `C::mask`; and a digest `Algorithm` is which static it is. That
# holds while the quotes have every match of these: each mention of `Ops`,
# each `Masker` literal, `impl` on `Masker`, and write to a `mask` field, which
# only `quic.rs` can make, and each `Algorithm` the source builds. Likewise
# `Verification::Ed25519` holds nothing and `Parsed::Ed25519` only its key,
# while the quotes have every mention of each: `ED25519` builds the only one
# of the first, with `parse_ed25519`, and each of the second has
# `Ed25519VerifyingKey::verify`. ECDSA's keys are modelled for P-256 with
# SHA-256 and fixed-length signatures, which holds while the quotes have each
# `Verification::Ecdsa`, `EcdsaP256`, and `EcdsaKey::`, each `EcdsaOps` and
# `EcdsaPair` built, which `load` alone builds, and each read of their `ops`.
# An AEAD `Sealer<C>` is its key, since the quoted `Sealer::expand` builds
# every `Ops`, of `C`'s own functions, while the quote has each mention of
# `Ops` in `aead.rs` and each `Algorithm` it builds.
only_quoted() {
    local file=$1 quote=$2 pattern=$3
    if [ "$(grep -oE "$pattern" "$file" | wc -l)" != "$(grep -oE "$pattern" "$quote" | wc -l)" ]; then
        echo "$file matches $pattern outside $quote" >&2
        exit 1
    fi
}
