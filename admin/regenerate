#!/usr/bin/env bash
# Re-runs every importer and generator at the upstream revision it pins, and
# fails if the generated code differs from the committed code or a committed
# file is one nothing generates, or if a file of rind's fork of s2n-bignum
# differs from upstream's at the fork's base without its `RIND.md` listing it.
#
# Usage: admin/regenerate
#
# Fetches each upstream shallowly into .tmp/upstream. Run it in the flake's
# `regenerate` dev shell, which pins the cross tools admin/parse-asm calls and
# the perl OpenSSL's perlasm runs on: `nix develop .#regenerate --command
# admin/regenerate`.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
upstream=.tmp/upstream

for name in aws-lc boringssl openssl hacl-star s2n-bignum; do
    admin/upstream "$name"
done

# The fork's files that differ from upstream's, or that upstream lacks, and
# those its `RIND.md` lists under "Changed files", one path a bullet.
fork=thirdparty/s2n-bignum
changed=$(find "$fork" -type f ! -path "$fork/RIND.md" -printf '%P\n' | LC_ALL=C sort | while read -r file; do
    cmp -s "$fork/$file" "$upstream/s2n-bignum/$file" || echo "$file"
done)
listed=$(sed -n '/^## Changed files$/,/^## /s/^- `\([^`]*\)`.*/\1/p' "$fork/RIND.md" | LC_ALL=C sort)
if ! diff -u --label "$fork/RIND.md" --label "changed from upstream" <(echo "$listed") <(echo "$changed") >&2; then
    echo "admin/regenerate: $fork/RIND.md lists other files than those that differ from upstream's" >&2
    exit 1
fi

# Deleted first, so a file nothing regenerates shows as deleted.
find rind/src/low/*/aws_lc rind/src/low/*/boringssl rind/src/low/*/openssl rind/src/low/*/hacl -type f -delete
grep -rlxZ '// generated source. do not edit.' rind/src | xargs -0 rm --

admin/import-aws-lc "$upstream/aws-lc"
admin/import-boringssl "$upstream/boringssl"
admin/import-openssl "$upstream/openssl"
admin/import-hacl "$upstream/hacl-star"
(cd admin/parse-asm && ./all.sh >/dev/null)
admin/p256-precomp
admin/p384-precomp
admin/p521-precomp

if [[ -n "$(git status --porcelain -- rind/src)" ]]; then
    git status --short -- rind/src >&2
    git --no-pager diff -- rind/src >&2
    echo "admin/regenerate: the generated code differs from the committed code" >&2
    exit 1
fi
echo "admin/regenerate: the generated code matches the committed code"
