#!/usr/bin/env python3
"""Regenerates the OpenSSL assembly under rind/src/low/*/openssl.

Usage: admin/import-openssl <OpenSSL checkout at REV>

aws-lc and BoringSSL lack these, so they come from OpenSSL, through
admin/import-aws-lc's steps: braces doubled, each routine rind calls or table
it loads a `{name}` operand, and each local label tagged with its file.
Undoing those edits, and the `.L` prefix added to the file's own symbols,
gives OpenSSL's text line for line.

x86_64: OpenSSL's SHA-256 and SHA-512 routines for AVX2 and BMI, and its
SHA-512 routine for the SHA512 instructions, which aws-lc's perlasm leaves
out. The perlasm generates the `elf` flavor for ELF and COFF and the `macosx`
flavor for Mach-O, and, as admin/import-aws-lc writes aws-lc's, each routine's
body goes into one file per flavor for `naked_asm!`. A table aws-lc's routines
already load is checked against rind's copy of it rather than written again.

32-bit ARM: OpenSSL's Keccak-f[1600], generated by its perlasm for the
`linux32` flavor and run through cpp for ARM mode, cut down to the integer and
NEON permutations and the round constants they load. Neither permutation is
global in OpenSSL, so rind's `global_asm!` makes each global under a
crate-version qualified symbol.
"""

import importlib.machinery
import importlib.util
import os
import subprocess
import sys
import tempfile

REV = "2f4e3a5fec05394068cfa7379890ab552483a8a6"

ADMIN = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("import_aws_lc", os.path.join(ADMIN, "import-aws-lc"))
aws_lc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(aws_lc)

IMPORTS_ARM = [
    {
        "perlasm": "crypto/sha/asm/keccak1600-armv4.pl",
        "out": "keccak1600-armv4.s",
        "tag": "keccak",
        "copyright": "Copyright 2017-2026 The OpenSSL Project Authors. All Rights Reserved.",
        # Each from its first line through its `.size`.
        "spans": [("iotas32", "KeccakF1600"), ("iotas64", "KeccakF1600_neon")],
        "routines": ["KeccakF1600", "KeccakF1600_neon"],
        # The file's other symbols, which only it uses.
        "locals": ["iotas32", "KeccakF1600_int", "KeccakF1600_enter", "iotas64"],
    },
]

IMPORTS_X86_64 = [
    {
        "perlasm": "crypto/sha/asm/sha512-x86_64.pl",
        # The perlasm reads the hash from its output's name.
        "out": "sha512-x86_64",
        "tag": "sha512",
        "copyright": "Copyright 2005-2026 The OpenSSL Project Authors. All Rights Reserved.",
        # Each table, and the aws-lc import that already holds it, if one does.
        "tables": {"K512": "sha512-x86_64", "K512_single": None},
        "routines": ["sha512_block_data_order_avx2", "sha512_block_data_order_sha512ext"],
    },
    {
        "perlasm": "crypto/sha/asm/sha512-x86_64.pl",
        "out": "sha256-x86_64",
        "tag": "sha256",
        "copyright": "Copyright 2005-2026 The OpenSSL Project Authors. All Rights Reserved.",
        "tables": {"K256": "sha256-x86_64"},
        "routines": ["sha256_block_data_order_avx2"],
    },
]

# The perlasm picks which routines to emit from the C compiler's version, so
# this names one that has them all, whatever the host has.
X86_64_CC = "echo clang version 20.0 #"

# OpenSSL's own name for the architecture level, which its `arm_arch.h`
# derives from the compiler's.
ARM_CPP = aws_lc.ARM_CPP + ["-D__ARM_ARCH__=7"]


def generate(openssl, perlasm):
    """The perlasm's `linux32` output, run through cpp without its one include."""
    out = subprocess.run(
        ["perl", os.path.join(openssl, perlasm), "linux32"], capture_output=True, text=True, check=True
    ).stdout
    text = "".join(line for line in out.splitlines(keepends=True) if line != '#include "arch/arm_arch.h"\n')
    cpp = ["cpp", "-x", "assembler-with-cpp", "-traditional-cpp", "-P", "-undef", "-nostdinc", *ARM_CPP, "-"]
    return subprocess.run(cpp, input=text, capture_output=True, text=True, check=True).stdout.splitlines()


def span(lines, first, last):
    """From `first`'s `.type` through `last`'s `.size`."""
    start = [i for i, line in enumerate(lines) if line.split()[:2] == [".type", f"{first},"]]
    if len(start) != 1:
        sys.exit(f"missing .type: {first}")
    end = aws_lc.find(lines, [".size", f"{last},.-{last}"], start[0])
    return lines[start[0] : end + 1]


def header(spec, comment="@", flavor="linux32"):
    return [
        f"{comment} {spec['copyright']}",
        f"{comment} SPDX-License-Identifier: Apache-2.0",
        f"{comment}",
        f"{comment} Generated by admin/import-openssl from OpenSSL {REV}:",
        f"{comment} the {flavor} flavor of {spec['perlasm']}.",
        f"{comment} Do not edit by hand.",
    ]


def import_arm(openssl):
    out_dir = os.path.join(aws_lc.ROOT, "arm", "openssl")
    os.makedirs(out_dir, exist_ok=True)
    for spec in IMPORTS_ARM:
        lines = generate(openssl, spec["perlasm"])
        text = [line for first, last in spec["spans"] for line in span(lines, first, last)]
        local = aws_lc.words(spec["locals"])
        text = [local.sub(lambda m: ".L" + m[1], line) for line in text]
        operands = {name: (name, 0) for name in spec["routines"]}
        text = aws_lc.escape(text, operands, ".L", spec["tag"], "@")
        aws_lc.write(os.path.join(out_dir, spec["out"]), header(spec) + list(text))


def generate_x86_64(openssl, spec, flavor):
    """The perlasm's output for `flavor`."""
    with tempfile.TemporaryDirectory() as tmp:
        out = os.path.join(tmp, spec["out"] + ".s")
        env = dict(os.environ, CC=X86_64_CC)
        subprocess.run(["perl", os.path.join(openssl, spec["perlasm"]), flavor, out], env=env, check=True)
        with open(out) as f:
            return f.read().splitlines()


def import_x86_64(openssl):
    arch = aws_lc.ARCHES["x86_64"]
    out_dir = os.path.join(aws_lc.ROOT, "x86_64", "openssl")
    os.makedirs(out_dir, exist_ok=True)
    for spec in IMPORTS_X86_64:
        for flavor, perlasm_flavor in [("linux", "elf"), ("apple", "macosx")]:
            local = arch["flavors"][flavor][3]
            lines = generate_x86_64(openssl, spec, perlasm_flavor)
            comment = arch["comment"]
            operands = {name: (name, 0) for name in spec["tables"]}
            for name in spec["routines"]:
                text = aws_lc.body(lines, f"{name}:", local)
                # As admin/import-aws-lc does, for ELF and COFF only.
                if flavor == "linux":
                    text = aws_lc.alignment(lines, name) + text
                text = aws_lc.escape(text, operands, local, spec["tag"], comment)
                out = os.path.join(out_dir, f"{name}.{flavor}.s")
                aws_lc.write(out, header(spec, comment, perlasm_flavor) + list(text))

            if flavor != "linux":
                continue
            for name, aws_lc_import in spec["tables"].items():
                values, width, _ = aws_lc.table(lines, f"{name}:", local)
                per_row = 16 // width
                rows = [f"    {', '.join(values[i : i + per_row])}," for i in range(0, len(values), per_row)]
                if aws_lc_import:
                    with open(os.path.join(aws_lc.ROOT, "x86_64", "aws_lc", f"{aws_lc_import}.{name}.rs")) as f:
                        if f.read().splitlines()[-len(rows) - 2 :] != ["["] + rows + ["]"]:
                            sys.exit(f"{spec['out']}: {name} differs from aws-lc's")
                    continue
                out = os.path.join(out_dir, f"{spec['out']}.{name}.rs")
                aws_lc.write(out, header(spec, "//", perlasm_flavor) + ["["] + rows + ["]"])


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    openssl = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", openssl, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"OpenSSL is at {rev}, expected {REV}")

    import_arm(openssl)
    import_x86_64(openssl)


if __name__ == "__main__":
    main()
