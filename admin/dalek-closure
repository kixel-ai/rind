#!/usr/bin/env python3
"""Fails unless two Aeneas translations of curve25519-dalek agree on what some functions reach.

Usage: admin/dalek-closure <want dir> <got dir> <configuration> <root>...

Each directory holds a translation's `Types.lean` and `Funs.lean`. From each
root, a name in the first translation, this follows every name of the first
translation's definitions that a reached definition's text names, and fails
unless the second translation defines each reached name with the same text,
up to what it names the locals its `let`s bind: BAIF's fork binds a value
the release reads twice, which Aeneas names after the fork's variable, so the
two translations of one function can name its locals apart. A definition's
text leaves out its doc comment, which cites the Rust's source lines. A multi-target translation suffixes what differs between its targets
with the target's name, `«32bit-tables»` and the like, so this follows only
`configuration`'s: a name that holds another target's, or the other word
size's backend, is not followed.

`admin/prove dalek` runs it with BAIF's translation first and rind's second.
"""

import re
import sys

NAME = re.compile(r"(?:[A-Za-z_][\w']*|«[^»]*»)(?:\.(?:[A-Za-z_][\w']*|«[^»]*»))*")
DECL = re.compile(
    r"^(?:@\[[^\]]*\]\s*)*(?:noncomputable\s+|private\s+|protected\s+|partial\s+)*"
    r"(?:def|impl_def|abbrev|structure|inductive|instance|opaque|axiom|theorem|class)\s+(\S+)",
    re.M,
)
CONFIGS = ["64bit-tables", "64bit-notables", "32bit-tables", "32bit-notables"]


def definitions(directory):
    """Each defined name's texts, from the doc comment Aeneas puts before each item.

    A trait declaration's or implementation's doc comment names its kind before
    the Rust path. Each is an item of its own, so a call through an
    implementation reaches its methods.
    """
    out = {}
    for module in ["Types", "Funs"]:
        with open(f"{directory}/{module}.lean") as f:
            text = f.read()
        preamble, *items = re.split(r"(?m)^(?=/-- (?:Trait (?:declaration|implementation): )?\[)", text)
        # A doc comment of a form the split misses would hide the names of the
        # items it joins.
        if DECL.search(preamble):
            sys.exit(f"admin/dalek-closure: {directory}/{module}.lean: a definition before the first item")
        for item in items:
            body = re.sub(r"(?s)^/--.*?-/\n", "", item, count=1).strip()
            decls = DECL.findall(body)
            if len(decls) != 1:
                sys.exit(f"admin/dalek-closure: {directory}/{module}.lean: not one definition in: {body[:200]}")
            out.setdefault(decls[0], []).append(body)
    return out


TOKEN = re.compile(r'"(?:[^"\\]|\\.)*"|\d[\w#.]*|' + NAME.pattern + r"|←|=>|:=|\S")
# What Aeneas's Lean names bare that is no local: a pattern of one binds
# nothing, and a `let` that bound one would hide it.
BUILTINS = {"some", "none", "ok", "fail", "div", "done", "cont", "true", "false", "lift", "massert", "loop"}


class Shadowed(Exception):
    pass


def canonical(body):
    """The definition's layout and tokens, with each local a `let` binds,
    where the text binds or names it, replaced by the index of that `let`.

    Each binder's scope is taken from the layout, as Lean's `do` takes it: a
    `let`'s runs until a line indented less than the `let`, a `fun`'s until
    a line indented less than the line that binds it, a pattern's until a
    line indented no more than its arm, and a parameter's to the end. Each
    holds the scope Lean gives the name, so the binder Lean picks for a name
    is always in scope, and a name bound again while a binder of it is in
    scope raises `Shadowed`, so the one in scope is Lean's.
    """
    out, active, lets, header = [], [], 0, True

    def bind(name, kind, column, index=None):
        if name in BUILTINS or any(b["name"] == name for b in active):
            raise Shadowed(name)
        active.append({"name": name, "kind": kind, "column": column, "index": index})

    for line in body.split("\n"):
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        active = [b for b in active if indent > b["column"] or (indent == b["column"] and b["kind"] != "pattern")]
        out.append(("line", indent))
        tokens = [(m.group(), m.start()) for m in TOKEN.finditer(line)]
        i = 0
        while i < len(tokens):
            token, column = tokens[i]
            local = lambda t: NAME.fullmatch(t) and "." not in t and t != "_"
            if token == ":=":
                header = False
            if header and token in "([{" and i + 2 < len(tokens) and tokens[i + 2][0] == ":" \
                    and local(tokens[i + 1][0]):
                bind(tokens[i + 1][0], "param", -1)
            if token == "fun" or (token == "|" and i == 0):
                j = i + 1
                while j < len(tokens) and tokens[j][0] != "=>":
                    t = tokens[j][0]
                    if local(t) and not (token == "|" and t in BUILTINS):
                        bind(t, "pattern" if token == "|" else "fun", indent)
                    j += 1
            if token == "let":
                out.append(("lit", token))
                i += 1
                while i < len(tokens) and tokens[i][0] not in ("←", ":=", ":"):
                    t = tokens[i][0]
                    if local(t):
                        bind(t, "let", column, lets)
                        out.append(("let", lets))
                        lets += 1
                    else:
                        out.append(("lit", t))
                    i += 1
                continue
            head, dot, rest = token.partition(".")
            binder = next((b for b in reversed(active) if b["name"] == head), None)
            if binder is not None and binder["kind"] == "let":
                out.append(("let", binder["index"]))
                if dot:
                    out.append(("lit", "." + rest))
            else:
                out.append(("lit", token))
            i += 1
    return out


def same(want, got):
    """Whether two lists of a name's definitions agree, up to what each
    definition names its `let`-bound locals."""
    if want == got:
        return True
    if got is None or len(want) != len(got):
        return False
    try:
        return all(canonical(w) == canonical(g) for w, g in zip(want, got))
    except Shadowed:
        return False


def main():
    if len(sys.argv) < 5:
        sys.exit(__doc__.split("\n\n")[1])
    want_dir, got_dir, config = sys.argv[1:4]
    roots = sys.argv[4:]
    if config not in CONFIGS:
        sys.exit(f"admin/dalek-closure: no configuration {config}")
    want, got = definitions(want_dir), definitions(got_dir)
    others = [c for c in CONFIGS if c != config]
    backend = ".u32." if config.startswith("64") else ".u64."

    def follow(name):
        return name in want and backend not in name and not any(o in name for o in others)

    reached, todo = set(), []
    for root in roots:
        if root not in want:
            sys.exit(f"admin/dalek-closure: {want_dir} defines no {root}")
        todo.append(root)
    while todo:
        name = todo.pop()
        if name in reached:
            continue
        reached.add(name)
        for body in want[name]:
            for token in NAME.findall(body):
                parts = token.split(".")
                for n in range(len(parts), 0, -1):
                    prefix = ".".join(parts[:n])
                    if prefix not in reached and follow(prefix):
                        todo.append(prefix)

    differ = sorted(n for n in reached if not same(want[n], got.get(n)))
    for name in differ:
        print(f"admin/dalek-closure: {name} is not the definition BAIF's proofs are about", file=sys.stderr)
    print(f"admin/dalek-closure: {len(reached)} definitions reached, {len(differ)} differ", file=sys.stderr)
    sys.exit(1 if differ else 0)


main()
