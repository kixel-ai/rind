#!/bin/sh
#
# This script analyses the structure of rind to ensure there are no references
# from rind::low to rind::mid, or rind::mid to rind::high.
set -e

# cargo-modules reads only signatures and `use` items, so also grep the source
# for a path into a higher layer. A file's `#[cfg(test)] mod x {` is skipped up
# to the column-0 `}` that rustfmt closes it with; any other match is an error.
(
  cd "$(dirname "$0")/.."
  files=$(find rind/src/low rind/src/mid -name '*.rs' | sort)
  awk '
    FNR == 1 { pending = 0; intest = 0 }
    intest { if ($0 !~ /^[}]/) next; intest = 0 }
    pending && /^(pub(\([^)]*\))? )?mod [A-Za-z0-9_]+ [{]$/ { pending = 0; intest = 1; next }
    /^#\[cfg\(test\)\]$/ { pending = 1 }
    !/^#\[/ { pending = 0 }
    /(crate|super)::high/ || FILENAME ~ /\/src\/low\// && /(crate|super)::mid/ {
      printf "ERROR: %s:%d names a higher layer: %s\n", FILENAME, FNR, $0 > "/dev/stderr"
      errors++
    }
    END {
      printf "%d errors\n", errors > "/dev/stderr"
      exit(errors > 0)
    }
  ' $files
)

# Captured first so a cargo-modules failure fails the script rather than
# feeding the filter an empty graph.
deps=$(cargo modules dependencies \
        --no-externs \
        --no-sysroot \
        -p rind)

# Each edge is a line `"tail" -> "head" [...]`, so splitting on quotes puts the
# tail in $2 and the head in $4.
printf '%s\n' "$deps" | awk -F'"' '
function layer(path) {
  if (index(path, "rind::low::") == 1) return "low";
  if (index(path, "rind::mid::") == 1) return "mid";
  if (index(path, "rind::high::") == 1) return "high";
  return "";
}
$3 == " -> " {
  from = layer($2);
  to = layer($4);
  if ((from == "low" && (to == "mid" || to == "high")) || (from == "mid" && to == "high")) {
    printf("ERROR: edge %s->%s is a dependency %s->%s\n", $2, $4, from, to) > "/dev/stderr";
    errors += 1;
  }
}
END {
  printf("%d errors\n", errors) > "/dev/stderr";
  exit(errors > 0);
}
'
