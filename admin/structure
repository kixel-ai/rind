#!/bin/sh
#
# This script analyses the structure of rind to ensure there are no references
# from rind::low to rind::mid, or rind::mid to rind::high.
set -e

# cargo-modules reads only signatures and `use` items, so also search the
# non-test source for a path naming a higher layer. The first pass finds
# test-only `mod x;` files; the second checks the rest.
(
  cd "$(dirname "$0")/.."
  files=$(find rind/src/low rind/src/mid -name '*.rs' | sort)
  awk '
    # Whether a cfg predicate holds only under test.
    function test_only(p,    args, n, i, depth, c, arg) {
      gsub(/[ \t]/, "", p)
      if (p == "test") return 1
      if (p !~ /^(all|any)\(.*\)$/) return 0
      n = 0; depth = 0; arg = ""
      for (i = 5; i < length(p); i++) {
        c = substr(p, i, 1)
        if (c == "," && depth == 0) { args[++n] = arg; arg = ""; continue }
        if (c == "(") depth++
        if (c == ")") depth--
        arg = arg c
      }
      if (arg != "") args[++n] = arg
      for (i = 1; i <= n; i++) {
        if (p ~ /^all/ && test_only(args[i])) return 1
        if (p ~ /^any/ && !test_only(args[i])) return 0
      }
      return p ~ /^any/ && n > 0
    }

    # The code in s, without comments, strings, or char literals; a block comment
    # or string may continue across lines. rawend closes a raw string.
    function code(s,    out) {
      out = ""
      while (s != "") {
        if (incomment) {
          if (!match(s, /\/\*|\*\//)) return out
          incomment += substr(s, RSTART, 2) == "/*" ? 1 : -1
          s = substr(s, RSTART + 2)
          continue
        }
        if (instr && rawend != "") {
          if (!index(s, rawend)) return out
          s = substr(s, index(s, rawend) + length(rawend)); instr = 0; out = out "\"\""
        } else if (instr) {
          if (!match(s, /^([^"\\]|\\.)*"/)) return out
          s = substr(s, RLENGTH + 1); instr = 0; out = out "\"\""
        }
        if (!match(s, /["\/\047]/)) return out s
        out = out substr(s, 1, RSTART - 1); s = substr(s, RSTART)
        if (s ~ /^"/) {
          instr = 1; s = substr(s, 2); rawend = ""
          if (match(out, /(^|[^A-Za-z0-9_]|[bc])r#*$/)) {
            rawend = substr(out, RSTART); sub(/^[^#]*/, "", rawend); rawend = "\"" rawend
          }
        }
        else if (s ~ /^\/\//) return out
        else if (s ~ /^\/\*/) { incomment = 1; s = substr(s, 3) }
        else if (match(s, /^\047([^\047\\]|\\.)\047/)) { out = out "\047 \047"; s = substr(s, RLENGTH + 1) }
        else { out = out substr(s, 1, 1); s = substr(s, 2) }
      }
      return out
    }

    FNR == 1 {
      pending = 0; skip = -1; attr = ""; inuse = 0; carry = ""; instr = 0; incomment = 0
      base = FILENAME; sub(/\/mod\.rs$/, "", base); sub(/\.rs$/, "", base)
      exempt = 0
      for (b in testmod) if (FILENAME == b ".rs" || index(FILENAME, b "/") == 1) exempt = 1
      layer = FILENAME ~ /\/src\/low\// ? "low" : "mid"
      higher = layer == "low" ? "(mid|high)" : "high"
    }
    exempt { next }

    # Whether the code s, on a line indented ind, ends the skipped test item.
    function ends(s, ind,    t) {
      t = s; depth += gsub(/[[({]/, "", t)
      t = s; depth -= gsub(/[])}]/, "", t)
      return depth <= 0 && ind == skip && s ~ /[;,}][ \t]*$/
    }

    # rustfmt ends a multi-line item on a line at its own indent; a code line
    # indented less has left it.
    skip >= 0 {
      match($0, /^ */); ind = RLENGTH
      if (instr || incomment || $0 !~ /[^ \t]/ || ind >= skip) {
        if (ends(code($0), ind)) skip = -1
        next
      }
      skip = -1
    }

    # Lex only lines that may hold a comment or an unclosed string.
    {
      line = $0
      if (instr || incomment || line ~ /[\/\047]|\\"|r#*"/) line = code(line)
      else if (index(line, "\"") && gsub(/"/, "\"", line) % 2) line = code(line)
      else if (index(line, "\"") && line ~ /high|mid|use|::/) gsub(/"[^"]*"/, "\"\"", line)
    }

    # A cfg attribute may wrap; judge it whole.
    attr != "" || line ~ /^[ \t]*#\[cfg\(/ {
      attr = attr " " line
      if (!index(attr, ")]")) next
      pred = attr; sub(/^[ \t]*#\[cfg\(/, "", pred); sub(/\)\].*/, "", pred)
      if (test_only(pred)) pending = 1
      sub(/^[^]]*\)\]/, "", attr)
      line = attr; attr = ""
    }

    pending && line ~ /^[ \t]*(#\[.*\])?[ \t]*$/ { next }

    pending {
      pending = 0; carry = ""
      if (line ~ /^[ \t]*(pub(\([^)]*\))?[ \t]+)?mod[ \t]+[A-Za-z0-9_]+[ \t]*;/) {
        name = line; sub(/^[ \t]*(pub(\([^)]*\))?[ \t]+)?mod[ \t]+/, "", name); sub(/[ \t]*;.*/, "", name)
        if (pass == 1) testmod[base "/" name] = 1
      } else {
        match($0, /^ */); skip = RLENGTH; depth = 0
        if (ends(line, skip)) skip = -1
      }
      next
    }

    pass == 1 { next }

    !inuse && line !~ /high|mid|use|::/ {
      if (line ~ /[^ \t]/) carry = ""
      next
    }

    {
      if (line ~ /^[ \t]*(pub(\([^)]*\))?[ \t]+)?use[ \t]/) inuse = 1
      text = carry " " line
      bad = text ~ ("(^|[^A-Za-z0-9_])" higher "[ \t]*::") || text ~ ("::[ \t]*" higher "([^A-Za-z0-9_]|$)")
      bad = bad || inuse && line ~ ("(^|[^A-Za-z0-9_])" higher "([^A-Za-z0-9_]|$)")
      if (inuse && line ~ /;/) inuse = 0
      carry = ""
      if (bad) {
        printf "ERROR: %s:%d names a layer above %s: %s\n", FILENAME, FNR, layer, $0 > "/dev/stderr"
        errors++
      } else if (match(line, /(::|[A-Za-z0-9_]+)[ \t]*$/)) carry = substr(line, RSTART)
    }

    END {
      printf "%d errors\n", errors > "/dev/stderr"
      exit(errors > 0)
    }
  ' pass=1 $files pass=2 $files
)

cat >structure.gvpr <<END
BEGIN {
  int rc = 0;
  int errors = 0;
}
E [match(tail.name, "rind::low::") == 0 && match(head.name, "rind::mid::") == 0] {
  printf(2, "ERROR: edge %s is a dependency low->mid\n", name);
  rc = 1;
  errors += 1;
}
E [match(tail.name, "rind::low::") == 0 && match(head.name, "rind::high::") == 0] {
  printf(2, "ERROR: edge %s is a dependency low->high\n", name);
  rc = 1;
  errors += 1;
}
E [match(tail.name, "rind::mid::") == 0 && match(head.name, "rind::high::") == 0] {
  printf(2, "ERROR: edge %s is a dependency mid->high\n", name);
  rc = 1;
  errors += 1;
}
END {
  printf(2, "%d errors\n", errors);
  exit(rc);
}
END

cargo modules dependencies \
        --no-externs \
        --no-sysroot \
        -p rind | gvpr -f structure.gvpr
