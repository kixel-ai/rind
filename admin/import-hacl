#!/usr/bin/env python3
"""Regenerates the HACL* assembly under rind/src/low/x86_64/hacl.

Usage: admin/import-hacl <HACL* checkout at REV>

x86_64: Vale's AES-GCM, from HACL*'s pregenerated `dist/vale`, which Vale
prints from the code its proofs check. One file per routine and flavor holds
the routine's body for `naked_asm!`, from after its label through its return,
and rustc emits the symbol and section directives for the object format, so
the `linux` flavor serves ELF and COFF and the `darwin` one Mach-O. The text
is Vale's line for line but each label, which Vale numbers across the file,
gains the flavor's local prefix and an `aesgcm_` tag, since the blocks share
an assembler scope. The routines load no tables and call nothing.
"""

import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys

REV = "f557259007db9933442dde10aa995c1b00bd3446"

ADMIN = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("import_aws_lc", os.path.join(ADMIN, "import-aws-lc"))
aws_lc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(aws_lc)

SOURCE = "aesgcm-x86_64"
TAG = "aesgcm"

# The key expansion, the GHASH key powers, the counter block, and the AEAD
# itself, for each key size. Not `gctr*_bytes`, which only EverCrypt's CTR
# mode calls.
ROUTINES = [
    "aes128_key_expansion",
    "aes256_key_expansion",
    "aes128_keyhash_init",
    "aes256_keyhash_init",
    "compute_iv_stdcall",
    "gcm128_encrypt_opt",
    "gcm256_encrypt_opt",
    "gcm128_decrypt_opt",
    "gcm256_decrypt_opt",
]

# Vale's flavor, its symbol prefix, and the local label prefix, per rind
# flavor.
FLAVORS = {
    "linux": ("linux", "", ".L"),
    "apple": ("darwin", "_", "L$"),
}

LABEL = re.compile(r"(?<![\w.$])(L\d+)(?![\w$])")


def header(name, source):
    # The AEAD routines interleave the six blocks as OpenSSL's do, from Vale's
    # port of them in vale/code/thirdPartyPorts/OpenSSL.
    port = ["# Ports OpenSSL's aesni-gcm-x86_64: Copyright 2013-2016 The OpenSSL Project Authors."]
    return [
        "# Copyright (c) 2016-2022 INRIA, CMU and Microsoft Corporation",
        "# Copyright (c) 2022-2023 HACL* Contributors",
        *(port if name.startswith("gcm") else []),
        "# SPDX-License-Identifier: Apache-2.0",
        "#",
        f"# Generated by admin/import-hacl from HACL* {REV}:",
        f"# {source}, which Vale generates from vale/code/crypto/aes/x64.",
        "# Do not edit by hand.",
    ]


def body(lines, label):
    """What follows `label` up to the next routine or the end."""
    start = aws_lc.find(lines, [label]) + 1
    end = start
    while end < len(lines) and lines[end].split()[:1] not in ([".global"], [".section"]):
        end += 1
    while not lines[end - 1].strip():
        end -= 1
    return lines[start:end]


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    hacl = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", hacl, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"HACL* is at {rev}, expected {REV}")

    out_dir = os.path.join(aws_lc.ROOT, "x86_64", "hacl")
    os.makedirs(out_dir, exist_ok=True)
    for flavor, (vale, prefix, local) in FLAVORS.items():
        source = os.path.join("dist", "vale", f"{SOURCE}-{vale}.S")
        with open(os.path.join(hacl, source)) as f:
            lines = f.read().splitlines()
        for name in ROUTINES:
            text = body(lines, f"{prefix}{name}:")
            text = [LABEL.sub(lambda m: f"{local}{TAG}_{m[1]}", line) for line in text]
            aws_lc.write(os.path.join(out_dir, f"{name}.{flavor}.s"), header(name, source) + text)


if __name__ == "__main__":
    main()
