#!/usr/bin/env python3
"""Regenerates the HACL* assembly under rind/src/low/x86_64/hacl.

Usage: admin/import-hacl <HACL* checkout at REV>

x86_64: Vale's SHA-256 for the SHA extensions, `sha256_update`, which Vale
prints from its proven `Vale.SHA.X64` into HACL*'s `dist/vale`. One file per
flavor holds its body for `naked_asm!`, through admin/import-aws-lc's steps:
braces doubled and each local label tagged with the routine. The routine
loads its round constants from a pointer argument, so it needs no `sym`
operand. Vale's two flavors differ only in their symbol prefix, so the
`linux` flavor's labels gain ELF's `.L` local prefix, which Apple's `L` is
already. Undoing those edits gives HACL*'s text line for line.
"""

import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys

REV = "f557259007db9933442dde10aa995c1b00bd3446"

ADMIN = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("import_aws_lc", os.path.join(ADMIN, "import-aws-lc"))
aws_lc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(aws_lc)

IMPORTS_X86_64 = [
    {
        "source": "sha256",
        "vaf": "vale/code/thirdPartyPorts/OpenSSL/sha/Vale.SHA.X64.vaf",
        "tag": "sha256_vale",
        "routine": "sha256_update",
    },
]

# Each flavor's HACL* file suffix, symbol prefix, and local label prefix.
FLAVORS = {
    "linux": ("linux", "", ".L"),
    "apple": ("darwin", "_", "L"),
}

# Vale names its local labels `L` and a number.
VALE_LABEL = re.compile(r"\bL(\d+)\b")


def header(spec, source):
    return [
        "# Copyright 2005-2016 The OpenSSL Project Authors. All Rights Reserved.",
        "# Copyright (c) 2016-2022 INRIA, CMU and Microsoft Corporation",
        "# Copyright (c) 2022-2023 HACL* Contributors",
        "# SPDX-License-Identifier: Apache-2.0",
        "#",
        f"# Generated by admin/import-hacl from HACL* {REV}:",
        f"# {source}, which Vale prints from {spec['vaf']}, its port of OpenSSL's code.",
        "# Do not edit by hand.",
    ]


def import_x86_64(hacl):
    out_dir = os.path.join(aws_lc.ROOT, "x86_64", "hacl")
    os.makedirs(out_dir, exist_ok=True)
    for spec in IMPORTS_X86_64:
        for flavor, (suffix, prefix, local) in FLAVORS.items():
            source = os.path.join("dist", "vale", f"{spec['source']}-x86_64-{suffix}.S")
            with open(os.path.join(hacl, source)) as f:
                lines = [VALE_LABEL.sub(local + r"\1", line) for line in f.read().splitlines()]
            body = aws_lc.body(lines, f"{prefix}{spec['routine']}:", local)
            text = aws_lc.escape(body, {}, local, spec["tag"], "#")
            out = os.path.join(out_dir, f"{spec['routine']}.{flavor}.s")
            aws_lc.write(out, header(spec, source) + list(text))


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    hacl = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", hacl, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"HACL* is at {rev}, expected {REV}")

    import_x86_64(hacl)


if __name__ == "__main__":
    main()
